---
const links = [
  { href: '#how-it-works', label: 'How it works' },
  { href: '#outcomes', label: 'Outcomes' },
  { href: '#security', label: 'Security' },
  { href: '#faq', label: 'FAQ' },
];
import BrandLogo from './BrandLogo.astro';
const themes = [
  { id: 'light', label: 'Daylight', ground: '#ececec', accent: '#00df79' },
  { id: 'ice', label: 'Ice', ground: '#eaf4f7', accent: '#0ea5c4' },
  { id: 'lagoon', label: 'Lagoon', ground: '#e9f5f3', accent: '#12b5a3' },
  { id: 'sand', label: 'Sand', ground: '#f3ecdf', accent: '#00c96e' },
  { id: 'peach', label: 'Peach', ground: '#fbeee4', accent: '#ef6b3d' },
  { id: 'butter', label: 'Butter', ground: '#f6f0e2', accent: '#e0932a' },
  { id: 'editorial', label: 'Editorial', ground: '#f4efe6', accent: '#d63423' },
  { id: 'dark', label: 'Midnight', ground: '#080c0a', accent: '#00df79' },
];
---

<header class="nav">
  <div class="shell nav__row">
    <a href="#top" class="brand" aria-label="NeoSapien NeoCore, home">
      <BrandLogo />
    </a>
    <nav class="nav__links" aria-label="Sections">
      {links.map((l) => <a href={l.href} class="nav__link">{l.label}</a>)}
    </nav>
    <div class="nav__actions">
      <div class="thm" data-theme-menu>
        <button type="button" class="tglr" data-theme-btn aria-haspopup="true" aria-expanded="false" aria-label="Choose colour theme">
          <span class="tglr__sw" data-theme-swatch aria-hidden="true"></span>
        </button>
        <div class="thm__pop" data-theme-pop role="menu" aria-label="Colour themes" hidden>
          {themes.map((t) => (
            <button type="button" class="thm__opt" role="menuitemradio" aria-checked="false" data-set-theme={t.id}>
              <span class="thm__sw" style={`--sw-g:${t.ground};--sw-a:${t.accent}`} aria-hidden="true"></span>
              <span class="thm__lbl">{t.label}</span>
              <span class="thm__ck" aria-hidden="true">✓</span>
            </button>
          ))}
        </div>
      </div>
      <a href="#pilot" class="pill nav__cta" data-lead-open data-evt="nav_cta_click" data-evt-source="nav">Talk to our enterprise team <span class="ico" aria-hidden="true">→</span></a>
      <button type="button" class="nav__toggle" data-nav-toggle aria-expanded="false" aria-controls="nav-drawer" aria-label="Open sections menu">
        <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M3 5h12M3 9h12M3 13h12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
      </button>
    </div>
  </div>
  <div class="nav__drawer" id="nav-drawer" data-nav-drawer hidden>
    <div class="shell nav__drawer-in">
      {links.map((l) => <a href={l.href} class="nav__drawer-link">{l.label}</a>)}
      <a href="#pilot" class="pill nav__drawer-cta" data-lead-open data-evt="nav_cta_click" data-evt-source="nav-mobile">Talk to our enterprise team <span class="ico" aria-hidden="true">→</span></a>
    </div>
  </div>
</header>

<style>
  .nav { position: fixed; top: 0; left: 0; right: 0; z-index: 40; padding: 16px 0; }
  .nav::before { content: ""; position: absolute; inset: 0; background: color-mix(in srgb, var(--ground) 78%, transparent); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); opacity: 0; transition: opacity .25s var(--ease); z-index: -1; }
  .nav__row { display: flex; align-items: center; gap: 24px; }
  .brand { display: inline-flex; align-items: center; text-decoration: none; margin-right: auto; }
  .nav__links { display: flex; align-items: center; gap: 28px; }
  .nav__link { color: var(--ink-2); text-decoration: none; font-size: 1rem; transition: color .16s var(--ease); }
  .nav__link:hover { color: var(--ink); }
  .nav__actions { display: flex; align-items: center; gap: 10px; }
  .thm { position: relative; }
  .tglr { width: 42px; height: 42px; border-radius: 50%; display: grid; place-items: center; color: var(--ink-2); border: 1.5px solid var(--hair); transition: color .16s var(--ease), border-color .16s var(--ease); }
  .tglr:hover { border-color: var(--green); }
  .tglr__sw { width: 18px; height: 18px; border-radius: 50%; background: var(--ground); border: 1.5px solid var(--ink-3); position: relative; overflow: hidden; }
  .tglr__sw::after { content: ""; position: absolute; right: -1px; bottom: -1px; width: 10px; height: 10px; border-radius: 50%; background: var(--green); }

  .thm__pop { position: absolute; top: calc(100% + 10px); right: 0; z-index: 60; width: 190px; padding: 6px; display: grid; gap: 2px;
    background: var(--surface); border: 1px solid var(--hair); border-radius: var(--r-m); box-shadow: var(--shadow-2);
    max-height: min(72vh, 460px); overflow-y: auto; }
  .thm__opt { display: flex; align-items: center; gap: 11px; width: 100%; padding: 10px 11px; border-radius: 12px; color: var(--ink-2); font-size: .95rem; font-weight: 500; text-align: left; transition: background .14s var(--ease), color .14s var(--ease); }
  .thm__opt:hover { background: var(--surface-2); color: var(--ink); }
  .thm__sw { width: 20px; height: 20px; border-radius: 50%; flex: none; background: var(--sw-g); border: 1.5px solid color-mix(in srgb, var(--ink-3) 60%, transparent); position: relative; overflow: hidden; }
  .thm__sw::after { content: ""; position: absolute; right: -2px; bottom: -2px; width: 11px; height: 11px; border-radius: 50%; background: var(--sw-a); }
  .thm__lbl { flex: 1; }
  .thm__ck { color: var(--green-text); font-weight: 800; font-size: .8rem; opacity: 0; }
  .thm__opt[aria-checked="true"] { color: var(--ink); }
  .thm__opt[aria-checked="true"] .thm__ck { opacity: 1; }
  .nav__toggle { display: none; width: 42px; height: 42px; border-radius: 50%; border: 1.5px solid var(--hair); color: var(--ink-2); place-items: center; }
  .nav__drawer { margin-top: 12px; }
  .nav__drawer-in { background: var(--surface); border: 1px solid var(--hair); border-radius: var(--r-m); padding: 10px; display: grid; gap: 2px; box-shadow: var(--shadow-2); }
  .nav__drawer-link { text-decoration: none; color: var(--ink-2); font-weight: 500; padding: 13px 14px; border-radius: 12px; }
  .nav__drawer-link:hover { background: var(--surface-2); color: var(--ink); }
  .nav__drawer-cta { justify-content: center; margin-top: 8px; }
  @media (max-width: 920px) { .nav__links, .nav__cta { display: none; } .nav__toggle { display: grid; } }
  @media (min-width: 921px) { .nav__drawer { display: none; } }
</style>

<script>
  // subtle backdrop once scrolled
  const nav = document.querySelector('.nav');
  if (nav) {
    const update = () => nav.classList.toggle('is-scrolled', window.scrollY > 12);
    update();
    window.addEventListener('scroll', update, { passive: true });
  }
</script>
<style>.nav.is-scrolled::before { opacity: 1; }</style>
