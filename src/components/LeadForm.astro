---
const CALENDLY = 'https://calendly.com/enterprise-neosapien/30min';
---

<dialog class="lead" id="lead-dialog" aria-labelledby="lead-title" data-calendly={CALENDLY}>
  <div class="lead__panel">
    <button type="button" class="lead__close" data-lead-close aria-label="Close">
      <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 3l10 10M13 3L3 13" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
    </button>

    <div data-lead-form-view>
      <span class="tag">Enterprise team</span>
      <h2 id="lead-title" class="lead__title">Tell us about your frontline team.</h2>
      <form class="lead__form" novalidate data-lead-form>
        <input type="hidden" name="cta_source" data-cta-source />
        <input type="hidden" name="page_section" data-page-section />
        <input type="hidden" name="campaign" data-campaign />
        <input type="hidden" name="referrer" data-referrer />

        <div class="field">
          <label for="lf-name">Name</label>
          <input id="lf-name" name="name" type="text" autocomplete="name" required />
          <p class="field__err" data-err-for="name" hidden></p>
        </div>
        <div class="field">
          <label for="lf-org">Organization</label>
          <input id="lf-org" name="organization" type="text" autocomplete="organization" required />
          <p class="field__err" data-err-for="organization" hidden></p>
        </div>
        <div class="field">
          <label for="lf-email">Official work email</label>
          <p class="field__help">Please use your organization email.</p>
          <input id="lf-email" name="email" type="email" autocomplete="email" inputmode="email" required />
          <p class="field__note" data-note-for="email" hidden></p>
          <p class="field__err" data-err-for="email" hidden></p>
        </div>
        <div class="field">
          <label for="lf-phone">Phone number</label>
          <input id="lf-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" required />
          <p class="field__err" data-err-for="phone" hidden></p>
        </div>
        <div class="field">
          <label for="lf-devices">Approximate device requirement <span class="field__opt">Optional</span></label>
          <div class="selwrap">
            <select id="lf-devices" name="devices">
              <option value="">Not sure yet</option>
              <option value="1-49">1–49</option>
              <option value="50-99">50–99</option>
              <option value="100-249">100–249</option>
              <option value="250+">250+</option>
            </select>
            <svg class="selchev" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M2 4l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
        </div>

        <p class="lead__banner" data-lead-banner hidden></p>
        <button type="submit" class="pill lead__submit" data-lead-submit>Talk to our enterprise team <span class="ico" aria-hidden="true">→</span></button>
        <p class="lead__legal muted">We save your details so we can follow up even if you don’t complete the booking.</p>
      </form>
    </div>

    <div class="lead__success" data-lead-success hidden>
      <span class="lead__check" aria-hidden="true"><svg width="26" height="26" viewBox="0 0 26 26"><path d="M6 13.5l4.5 4.5L20 8" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
      <h2 class="lead__title">You’re on the list.</h2>
      <p class="muted">Redirecting you to book a 30-minute conversation with the enterprise team…</p>
      <a class="tlink" data-lead-calendly href={CALENDLY}>Continue to booking</a>
    </div>
  </div>
</dialog>

<style>
  /* Right-side sheet: pinned to the right edge, full viewport height. */
  .lead { position: fixed; inset: 0 0 0 auto; margin: 0; border: none; padding: 0; background: transparent;
    width: min(460px, 100vw); max-width: none; height: 100dvh; max-height: 100dvh; color: var(--ink); }
  .lead::backdrop { background: rgba(10, 20, 14, 0.5); backdrop-filter: blur(3px); }
  .lead[open] { animation: leadIn .28s var(--ease); }
  @keyframes leadIn { from { opacity: 0; transform: translateX(28px); } }
  @media (prefers-reduced-motion: reduce) { .lead[open] { animation: none; } }

  .lead__panel { position: relative; height: 100%; background: var(--surface); border: none; border-left: 1px solid var(--hair);
    border-radius: 0; padding: clamp(28px, 4vw, 40px); box-shadow: var(--shadow-3); overflow-y: auto;
    display: flex; flex-direction: column; justify-content: center; }
  .lead__close { position: absolute; top: 18px; right: 18px; width: 36px; height: 36px; display: grid; place-items: center; border-radius: 50%; background: var(--surface-2); border: 1px solid var(--hair); color: var(--ink-2); }
  .lead__close:hover { color: var(--ink); }
  .lead__title { font-size: 1.6rem; font-weight: 500; margin-top: 14px; letter-spacing: -0.02em; }
  .lead__form { margin-top: 22px; display: grid; gap: 16px; }

  .field { display: grid; gap: 6px; }
  .field label { font-size: .92rem; font-weight: 500; display: flex; align-items: center; gap: 8px; }
  .field__opt { font-size: .68rem; color: var(--ink-3); border: 1px solid var(--hair); border-radius: var(--r-pill); padding: 2px 9px; text-transform: uppercase; letter-spacing: .06em; }
  .field__help { font-size: .84rem; color: var(--ink-3); margin: -2px 0 2px; }
  .field input, .selwrap select { width: 100%; background: var(--surface-2); color: var(--ink); border: 1px solid var(--hair); border-radius: 12px; padding: 13px 15px; font-size: 1rem; transition: border-color .16s var(--ease), box-shadow .16s var(--ease); }
  .field input:focus, .selwrap select:focus { outline: none; border-color: var(--green); box-shadow: 0 0 0 3px var(--green-glow); }
  .field input[aria-invalid="true"] { border-color: #e0634e; }
  .field__err { font-size: .84rem; color: #e0634e; }
  .field__note { font-size: .84rem; color: #c88a1e; }
  .selwrap { position: relative; }
  .selwrap select { appearance: none; -webkit-appearance: none; cursor: pointer; }
  .selchev { position: absolute; right: 15px; top: 50%; transform: translateY(-50%); color: var(--ink-3); pointer-events: none; }

  .lead__banner { font-size: .9rem; color: #c0402c; background: rgba(224,99,78,.1); border: 1px solid rgba(224,99,78,.4); border-radius: 12px; padding: 11px 14px; }
  .lead__submit { width: 100%; justify-content: center; margin-top: 4px; }
  .lead__submit[aria-busy="true"] { opacity: .6; pointer-events: none; }
  .lead__legal { font-size: .82rem; line-height: 1.45; }

  .lead__success { text-align: center; padding: 16px 8px 8px; display: grid; gap: 12px; justify-items: center; }
  .lead__check { width: 58px; height: 58px; border-radius: 50%; display: grid; place-items: center; background: var(--green); color: var(--green-ink); }
</style>

<script>
  const dialog = document.getElementById('lead-dialog') as HTMLDialogElement | null;
  if (dialog) {
    const CAL = dialog.dataset.calendly!;
    const form = dialog.querySelector<HTMLFormElement>('[data-lead-form]')!;
    const formView = dialog.querySelector<HTMLElement>('[data-lead-form-view]')!;
    const successView = dialog.querySelector<HTMLElement>('[data-lead-success]')!;
    const banner = dialog.querySelector<HTMLElement>('[data-lead-banner]')!;
    const submitBtn = dialog.querySelector<HTMLButtonElement>('[data-lead-submit]')!;
    const emailNote = form.querySelector<HTMLElement>('[data-note-for="email"]')!;
    let started = false;
    const track = (e: string, d: Record<string, unknown> = {}) => window.neoTrack?.(e, d);
    const PUBLIC = ['gmail.com','yahoo.com','yahoo.co.in','outlook.com','hotmail.com','live.com','icloud.com','proton.me','protonmail.com','rediffmail.com'];

    const setError = (name: string, msg: string | null) => {
      const input = form.querySelector<HTMLElement>(`[name="${name}"]`);
      const err = form.querySelector<HTMLElement>(`[data-err-for="${name}"]`);
      if (input) input.setAttribute('aria-invalid', msg ? 'true' : 'false');
      if (err) { err.textContent = msg || ''; err.hidden = !msg; }
    };
    const validate = () => {
      let ok = true;
      const data = new FormData(form);
      const req: [string, string][] = [['name','Please enter your name.'],['organization','Please enter your organization.'],['email','Please enter your work email.'],['phone','Please enter your phone number.']];
      for (const [n, m] of req) { if (!String(data.get(n) || '').trim()) { setError(n, m); ok = false; } else setError(n, null); }
      const email = String(data.get('email') || '').trim();
      if (email && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { setError('email', 'Please enter a valid email address.'); ok = false; }
      const phone = String(data.get('phone') || '').replace(/[^\d]/g, '');
      if (phone && phone.length < 7) { setError('phone', 'Please enter a valid phone number.'); ok = false; }
      const domain = email.split('@')[1]?.toLowerCase();
      emailNote.hidden = !(domain && PUBLIC.includes(domain));
      if (domain && PUBLIC.includes(domain)) emailNote.textContent = 'That looks like a personal email. A work email helps us route you faster; you can still continue.';
      return ok;
    };
    const open = (source: string, section: string) => {
      (form.querySelector('[data-cta-source]') as HTMLInputElement).value = source;
      (form.querySelector('[data-page-section]') as HTMLInputElement).value = section;
      const params = new URLSearchParams(location.search);
      (form.querySelector('[data-campaign]') as HTMLInputElement).value = params.get('utm_campaign') || params.get('campaign') || '';
      (form.querySelector('[data-referrer]') as HTMLInputElement).value = document.referrer || '';
      formView.hidden = false; successView.hidden = true; banner.hidden = true;
      if (typeof dialog.showModal === 'function') dialog.showModal(); else dialog.setAttribute('open','');
      if (!started) { started = true; track('form_start', { source }); }
      setTimeout(() => form.querySelector<HTMLInputElement>('#lf-name')?.focus(), 60);
    };
    document.addEventListener('click', (e) => {
      const opener = (e.target as HTMLElement).closest<HTMLElement>('[data-lead-open]');
      if (opener) { e.preventDefault(); open(opener.dataset.evtSource || 'unknown', opener.closest('section')?.id || 'page'); }
      if ((e.target as HTMLElement).closest('[data-lead-close]')) dialog.close();
    });
    dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
    form.addEventListener('blur', (e) => { if ((e.target as HTMLElement).matches('input')) validate(); }, true);
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!validate()) { track('form_validation_failure'); return; }
      submitBtn.setAttribute('aria-busy', 'true'); banner.hidden = true;
      const payload = Object.fromEntries(new FormData(form).entries());
      try {
        const endpoint = (window as any).NEO_LEAD_ENDPOINT as string | undefined;
        if (endpoint) {
          const res = await fetch(endpoint, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
          if (!res.ok) throw new Error('save_failed');
        } else { console.warn('[NeoCore] NEO_LEAD_ENDPOINT not configured; lead not persisted.', payload); }
        track('form_submission', { source: payload.cta_source });
        formView.hidden = true; successView.hidden = false;
        const url = new URL(CAL);
        if (payload.cta_source) url.searchParams.set('utm_source', String(payload.cta_source));
        (successView.querySelector('[data-lead-calendly]') as HTMLAnchorElement).href = url.toString();
        track('calendly_redirect', { source: payload.cta_source });
        setTimeout(() => { location.href = url.toString(); }, 1400);
      } catch {
        submitBtn.removeAttribute('aria-busy');
        banner.hidden = false;
        banner.textContent = 'We couldn’t save your details just now. Please try again; you won’t be redirected until this succeeds.';
      }
    });
  }
</script>
