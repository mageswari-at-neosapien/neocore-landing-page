---
const logos = [
  { f: 'diageo', n: 'Diageo' }, { f: 'p-and-g', n: 'P&G', pilot: true },
  { f: 'itc-limited', n: 'ITC Limited', pilot: true }, { f: 'eureka-forbes', n: 'Eureka Forbes' },
  { f: 'panasonic', n: 'Panasonic', pilot: true }, { f: 'mamaearth', n: 'Mamaearth', pilot: true },
  { f: 'page-industries-limited', n: 'Page Industries Limited' }, { f: 'ather', n: 'Ather' },
  { f: 'mahindra-rise', n: 'Mahindra Rise' }, { f: 'honda', n: 'Honda', pilot: true },
  { f: 'shriram-properties', n: 'Shriram Properties', pilot: true }, { f: 'homelane', n: 'HomeLane', pilot: true },
  { f: 'the-souled-store', n: 'The Souled Store' }, { f: 'sony-entertainment-television', n: 'Sony Entertainment Television' },
  { f: 'specsmakers', n: 'Specsmakers' }, { f: 'big-fm', n: 'BIG FM' },
  { f: 'zee-entertainment-enterprises', n: 'Zee Entertainment Enterprises', pilot: true },
  { f: 'government-of-andhra-pradesh', n: 'Government of Andhra Pradesh', pilot: true },
  { f: 'uttar-pradesh-police', n: 'Uttar Pradesh Police' }, { f: 'bodycraft', n: 'Bodycraft' },
  { f: 'emirates', n: 'Emirates' }, { f: 'larsen-and-toubro', n: 'Larsen & Toubro' },
  { f: 'matrix-life-science', n: 'Matrix Life Science', pilot: true }, { f: 'acko', n: 'ACKO', pilot: true },
  { f: 'om-logistics-supply-chain', n: 'OM Logistics Supply Chain', pilot: true },
  { f: 'hindustan-petroleum', n: 'Hindustan Petroleum' },
  { f: 'christ-deemed-to-be-university', n: 'CHRIST (Deemed to be University)' },
];
const rowA = logos.slice(0, 14);
const rowB = logos.slice(14);
const outcomes = [
  { fig: '70%+', desc: 'Utilization reported for the always-on option' },
  { fig: '+15%', desc: 'Increase in lines per store in a leading FMCG rollout' },
  { fig: '+20%', desc: 'Increase in sales per store in the same rollout' },
];
---

<section class="fold trust">
  <div class="shell">
    <div class="fold-head reveal">
      <h2 class="h2">Engagement with leaders <span class="b">across sectors</span></h2>
      <p class="lede">Across CPG and durables, automotive, real estate, retail and media, public sector and more. <span class="muted">Plus a growing clientele of 25+ SMBs.</span></p>
    </div>
  </div>

  <div class="marquee reveal" aria-label="Organizations engaged across sectors">
    <div class="mrow">
      <div class="mtrack">
        {[...rowA, ...rowA].map((l) => (
          <span class="ml"><img src={`/logos/${l.f}.png`} alt={l.n} loading="lazy" decoding="async" width="120" height="40" /></span>
        ))}
      </div>
    </div>
    <div class="mrow">
      <div class="mtrack mtrack--rev">
        {[...rowB, ...rowB].map((l) => (
          <span class="ml"><img src={`/logos/${l.f}.png`} alt={l.n} loading="lazy" decoding="async" width="120" height="40" /></span>
        ))}
      </div>
    </div>
  </div>

  <div class="shell">
    <div class="stats reveal">
      {outcomes.map((o) => (
        <div class="stat">
          <div class="stat__fig">{o.fig}</div>
          <p class="stat__desc">{o.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .trust .fold-head { margin-bottom: 44px; }
  .marquee { position: relative; display: flex; flex-direction: column; gap: 18px; margin-bottom: 64px;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 7%, #000 93%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 7%, #000 93%, transparent); }
  .mrow { overflow: hidden; height: 60px; }
  .mtrack { display: flex; flex-flow: row nowrap; align-items: center; gap: 40px; width: max-content; }
  @media (prefers-reduced-motion: no-preference) {
    .mtrack { animation: marq 64s linear infinite; }
    .mtrack--rev { animation-direction: reverse; }
    .marquee:hover .mtrack { animation-play-state: paused; }
  }
  @keyframes marq { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  /* full-colour logos, no boxes, moving */
  .ml { flex: 0 0 auto; display: inline-flex; align-items: center; justify-content: center; width: 144px; height: 56px; padding: 8px 18px; }
  .ml img { width: auto; height: auto; max-height: 34px; max-width: 100%; object-fit: contain; }

  .stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(24px, 5vw, 72px); }
  .stat__fig { font-size: clamp(3.6rem, 7vw, 6rem); font-weight: 500; letter-spacing: -0.04em; color: var(--green-text); line-height: .9; }
  .stat__desc { margin-top: 16px; color: var(--ink-2); font-size: 1.08rem; line-height: 1.4; max-width: 24ch; }
  .stats__foot { margin-top: 40px; font-size: .9rem; }

  @media (max-width: 720px) { .stats { grid-template-columns: 1fr; gap: 40px; } }
</style>
