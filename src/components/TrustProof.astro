---
// Fold 2 — "Live with industry leaders": logos grouped into industry cards,
// each card runs a subtle marquee of its brand logos inside. Reuses existing assets.
const sectors = [
  { label: 'CPG / Durables', logos: [
    { f: 'diageo', n: 'Diageo' }, { f: 'p-and-g', n: 'P&G' }, { f: 'itc-limited', n: 'ITC Limited' },
    { f: 'eureka-forbes', n: 'Eureka Forbes' }, { f: 'lt-foods', n: 'LT Foods' }, { f: 'panasonic', n: 'Panasonic' },
    { f: 'mamaearth', n: 'Mamaearth' },
  ] },
  { label: 'Automotive', logos: [
    { f: 'ather', n: 'Ather' }, { f: 'mahindra-rise', n: 'Mahindra' }, { f: 'bridgestone', n: 'Bridgestone' }, { f: 'honda', n: 'Honda' },
  ] },
  { label: 'Real Estate', logos: [
    { f: 'shriram-properties', n: 'Shriram Properties' }, { f: 'homelane', n: 'HomeLane' },
  ] },
  { label: 'Healthcare / Pharma', logos: [
    { f: 'superhealth', n: 'SuperHealth' }, { f: 'matrix-life-science', n: 'Matrix Life Science' },
    { f: 'acko', n: 'ACKO' }, { f: 'cipla', n: 'Cipla' },
  ] },
  { label: 'Retail / Media', logos: [
    { f: 'sony-entertainment-television', n: 'Sony Entertainment Television' }, { f: 'big-fm', n: 'BIG FM' },
    { f: 'zee-entertainment-enterprises', n: 'Zee' }, { f: 'the-souled-store', n: 'The Souled Store' },
  ] },
  { label: 'Financial Services / Public Sector', logos: [
    { f: 'mindgate', n: 'Mindgate' }, { f: 'one-percent-club', n: '1% Club' },
    { f: 'government-of-andhra-pradesh', n: 'Government of Andhra Pradesh' }, { f: 'uttar-pradesh-police', n: 'Uttar Pradesh Police' },
    { f: 'larsen-and-toubro', n: 'Larsen & Toubro' }, { f: 'hindustan-petroleum', n: 'Hindustan Petroleum' },
  ] },
  { label: 'Others', logos: [
    { f: 'om-logistics-supply-chain', n: 'OM Logistics Supply Chain' }, { f: 'dcm-shriram', n: 'DCM Shriram' },
    { f: 'christ-deemed-to-be-university', n: 'Christ (Deemed to be University)' },
  ] },
];
const outcomes = [
  { fig: '1000+', desc: 'Devices deployed' },
  { fig: '70%', desc: 'Daily active users in our largest rollout' },
  { fig: '+20%', desc: 'Increase in sales productivity' },
];
---

<section class="fold trust">
  <div class="shell">
    <div class="fold-head reveal">
      <h2 class="h2">Live with <span class="b">industry leaders</span></h2>
    </div>

    <div class="lgrid reveal">
      {sectors.map((s, i) => (
        <div class="lcard">
          <span class="lcard__label">{s.label}</span>
          <div class="lcard__marq">
            <div class="lcard__track" class:list={[{ 'lcard__track--rev': i % 2 === 1 }]} style={`--n:${s.logos.length}`}>
              {[...s.logos, ...s.logos].map((l) => (
                <span class="lchip"><img src={`/logos/${l.f}.png`} alt={l.n} loading="lazy" decoding="async" width="120" height="40" /></span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>

    <div class="trust__stathead reveal">
      <h3 class="h3 trust__stath">Outcomes from live enterprise rollouts.</h3>
    </div>
    <div class="stats reveal">
      {outcomes.map((o) => (
        <div class="stat">
          <div class="stat__fig">{o.fig}</div>
          <p class="stat__desc">{o.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .trust .fold-head { margin-bottom: 36px; }

  /* industry cards — flex so partial last row centers (no lone stretched card) */
  .lgrid { display: flex; flex-wrap: wrap; gap: 14px; justify-content: center; }
  .lcard { position: relative; flex: 0 1 calc(25% - 11px); min-width: 250px; background: var(--bubble); border: 1px solid color-mix(in srgb, var(--green) 16%, transparent); border-radius: var(--r-m); padding: 16px 0 18px; overflow: hidden; box-shadow: var(--shadow-2); }
  .lcard::before { content: ""; position: absolute; inset: 0 0 auto 0; height: 1px; border-radius: var(--r-m) var(--r-m) 0 0; background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--green) 55%, transparent), transparent); }
  .lcard__label { display: block; text-align: center; font-size: .7rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--bubble-ink-2); padding: 0 16px 13px; margin-bottom: 6px; border-bottom: 1px solid color-mix(in srgb, var(--bubble-ink-2) 18%, transparent); }

  /* subtle marquee inside each card */
  .lcard__marq { overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent); }
  .lcard__track { display: flex; flex-flow: row nowrap; align-items: center; gap: 34px; width: max-content; padding: 10px 22px; }
  @media (prefers-reduced-motion: no-preference) {
    /* duration scales with logo count → every card scrolls at the same visual speed */
    .lcard__track { animation: lmarq calc(var(--n, 5) * 2.2s) linear infinite; }
    .lcard__track--rev { animation-direction: reverse; }
    .lcard:hover .lcard__track { animation-play-state: paused; }
  }
  @keyframes lmarq { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  .lchip { flex: 0 0 auto; display: inline-flex; align-items: center; justify-content: center; height: 48px; }
  .lchip img { width: auto; height: auto; max-height: 34px; max-width: 132px; object-fit: contain; }

  /* outcomes */
  .trust__stathead { margin-top: clamp(48px, 6vw, 72px); margin-bottom: clamp(24px, 3vw, 34px); }
  .trust__stath { color: var(--ink); white-space: nowrap; }
  @media (max-width: 620px) { .trust__stath { white-space: normal; } }
  .stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(24px, 5vw, 72px); }
  .stat__fig { font-size: clamp(3.6rem, 7vw, 6rem); font-weight: 500; letter-spacing: -0.04em; color: var(--green-text); line-height: .9; }
  .stat__desc { margin-top: 16px; color: var(--ink-2); font-size: 1.08rem; line-height: 1.4; max-width: 24ch; }

  @media (max-width: 720px) {
    .trust .fold-head { text-align: center; }
    .trust__stathead { text-align: center; }
    .stats { grid-template-columns: 1fr; gap: 40px; justify-items: center; text-align: center; }
    .stat { display: flex; flex-direction: column; align-items: center; }
    .stat__desc { max-width: 28ch; }
  }
</style>
