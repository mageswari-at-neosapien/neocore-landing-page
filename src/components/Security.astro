---
// Fold 5 — Enterprise data, security & integrations.
// "Redaction in action": prove PII redaction rather than just claim it.
const proof = [
  'ISO 27001 certified',
  'No audio storage by default',
  'No training on customer data',
  'India-resident servers',
  'Configurable PII redaction',
  'Role-based access',
  'APIs and MCP',
];
const stages = ['Capture', 'Encrypted', 'Process', 'Redact PII', 'Deliver'];
---

<section id="security" class="fold sec glowsec">
  <span class="secglow" aria-hidden="true"></span>
  <div class="shell sec__grid">
    <div class="sec__copy reveal">
      <h2 class="h2">Enterprise-ready <span class="b">by design.</span></h2>
      <p class="lede">NeoCore combines configurable intelligence with the security, data controls and integrations required for enterprise deployment.</p>
      <ul class="prooflist" aria-label="Security and data proof points">
        {proof.map((p) => (
          <li class="proof"><span class="proof__ck" aria-hidden="true">✓</span>{p}</li>
        ))}
      </ul>
    </div>

    <div class="sec__view reveal">
      <div class="redact" data-redact>
        <div class="redact__head">
          <span class="redact__cap"><span class="live" aria-hidden="true"></span>Secure processing</span>
          <span class="iso" role="img" aria-label="ISO 27001 certified — official badge to be supplied"><span class="iso__k">ISO 27001</span><span class="iso__s">Certified</span></span>
        </div>

        <ol class="redact__flow" aria-hidden="true">
          {stages.map((s, i) => (
            <li class="rf" class:list={[{ 'rf--guard': i === 3 }]}><span class="rf__dot"></span><span class="rf__t">{s}</span></li>
          ))}
        </ol>

        <div class="redact__body">
          <span class="redact__lbl">Captured transcript</span>
          <p class="redact__line">Rep <span class="pii">Priya Sharma</span> reached the retailer on <span class="pii">+91 98••• ••21</span> to walk through the Q3 scheme and the approved margin comparison.</p>
          <div class="redact__stamp"><span class="redact__ck">✓</span>PII redacted · India-resident servers · no audio stored</div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .glowsec { position: relative; overflow: hidden; }
  .secglow { position: absolute; right: -12%; top: 4%; width: 700px; height: 600px; border-radius: 50%; pointer-events: none; z-index: 0;
    background: radial-gradient(circle, var(--green-glow), transparent 66%); filter: blur(34px); }
  .glowsec .shell { position: relative; z-index: 1; }

  .sec__grid { display: grid; grid-template-columns: 0.92fr 1.08fr; gap: clamp(32px, 5vw, 72px); align-items: center; }
  .sec__copy { max-width: 520px; }
  .prooflist { list-style: none; margin-top: clamp(28px, 3vw, 40px); display: grid; grid-template-columns: 1fr 1fr; gap: 14px 24px; }
  .proof { display: inline-flex; align-items: center; gap: 11px; font-size: 1rem; font-weight: 500; color: var(--ink); }
  .proof__ck { width: 22px; height: 22px; border-radius: 50%; background: var(--green); color: var(--green-ink); display: grid; place-items: center; font-size: .68rem; font-weight: 800; flex: none; }

  /* the redaction panel — a dark "screen" in both themes */
  .redact { position: relative; background: var(--bubble); border-radius: var(--r-l); padding: clamp(22px, 2.2vw, 30px); color: var(--bubble-ink); box-shadow: var(--shadow-3); border: 1px solid color-mix(in srgb, var(--green) 14%, transparent); }
  .redact::before { content: ""; position: absolute; inset: 0 0 auto 0; height: 1px; border-radius: var(--r-l) var(--r-l) 0 0; background: linear-gradient(90deg, transparent, rgba(0,223,121,.4), transparent); }
  .redact__head { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 22px; }
  .redact__cap { display: inline-flex; align-items: center; gap: 9px; font-size: .72rem; letter-spacing: .08em; text-transform: uppercase; color: var(--bubble-ink-2); }
  .iso { display: inline-flex; flex-direction: column; align-items: center; gap: 2px; padding: 8px 14px; border-radius: 10px; border: 1.5px solid var(--green); }
  .iso__k { font-weight: 600; font-size: .82rem; }
  .iso__s { color: var(--green); font-size: .62rem; font-weight: 500; letter-spacing: .06em; text-transform: uppercase; }

  .redact__flow { list-style: none; display: flex; align-items: center; justify-content: space-between; gap: 6px; margin-bottom: 24px; }
  .rf { display: flex; align-items: center; gap: 8px; font-size: .68rem; letter-spacing: .03em; text-transform: uppercase; color: var(--bubble-ink-2); }
  .rf:not(:last-child)::after { content: ""; width: 14px; height: 1px; background: var(--inset-line); margin-left: 2px; }
  .rf__dot { width: 8px; height: 8px; border-radius: 50%; background: var(--inset-line); flex: none; }
  .rf--guard { color: var(--green); }
  .rf--guard .rf__dot { background: var(--green); box-shadow: 0 0 0 3px var(--green-glow); }
  .is-redacting .rf--guard .rf__dot { animation: rfPulse 1s ease-in-out infinite; }
  @keyframes rfPulse { 0%,100% { box-shadow: 0 0 0 3px var(--green-glow); } 50% { box-shadow: 0 0 0 8px rgba(0,223,121,0); } }

  .redact__body { background: var(--inset); border-radius: var(--r-m); padding: 20px; }
  .redact__lbl { font-size: .64rem; letter-spacing: .06em; text-transform: uppercase; color: var(--bubble-ink-2); }
  .redact__line { margin-top: 12px; font-size: 1.12rem; line-height: 1.55; color: var(--bubble-ink); }
  .pii { position: relative; display: inline-block; transition: color .2s var(--ease); }
  .pii::after { content: ""; position: absolute; left: -4px; right: -4px; top: -1px; bottom: -1px; border-radius: 4px;
    background: #26332b; box-shadow: inset 3px 0 0 var(--green); transform: scaleX(0); transform-origin: left;
    transition: transform .5s cubic-bezier(.4,.7,.35,1); }
  .is-redacted .pii { color: transparent; }
  .is-redacted .pii::after { transform: scaleX(1); }
  .redact__stamp { display: inline-flex; align-items: center; gap: 9px; margin-top: 18px; font-size: .84rem; color: var(--green);
    opacity: 0; transform: translateY(4px); transition: opacity .4s var(--ease) .35s, transform .4s var(--ease) .35s; }
  .is-redacted .redact__stamp { opacity: 1; transform: none; }
  .redact__ck { width: 20px; height: 20px; border-radius: 50%; background: var(--green); color: var(--green-ink); display: grid; place-items: center; font-size: .62rem; font-weight: 800; flex: none; }

  @media (max-width: 940px) {
    .sec__grid { grid-template-columns: 1fr; gap: 36px; }
    .sec__copy { max-width: none; }
  }
  @media (max-width: 520px) { .prooflist { grid-template-columns: 1fr; } .redact__flow { flex-wrap: wrap; } }
</style>

<script>
  // Redaction demo — loops while in view: highlight the redact stage, black out the PII, stamp it.
  const el = document.querySelector<HTMLElement>('[data-redact]');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (el && !reduced) {
    const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));
    let visible = false, looping = false;
    const loop = async () => {
      if (looping) return; looping = true;
      while (visible) {
        el.classList.remove('is-redacted');
        el.classList.add('is-redacting');
        await wait(1100);            // the redact stage pulses (analysing)
        el.classList.add('is-redacted');  // bars slide over the PII, stamp appears
        await wait(4200);            // hold the redacted, secured state
        if (!visible) break;
      }
      looping = false;
    };
    const io = new IntersectionObserver(
      (entries) => entries.forEach((e) => { visible = e.isIntersecting; if (visible) loop(); }),
      { threshold: 0.35 }
    );
    io.observe(el);
  }
</script>
