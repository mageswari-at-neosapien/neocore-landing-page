---
const faqs = [
  { id: 'neo-one-vs-neocore', q: 'What is the difference between Neo One and NeoCore?', a: 'Neo One captures frontline conversations. NeoCore processes, structures and aggregates those conversations into management intelligence for adherence, coaching and Voice of Customer.', open: true },
  { id: 'languages', q: 'Can NeoCore work across languages and company-specific terminology?', a: 'Yes. NeoCore supports 100+ languages and can be tuned for product names, local brands, competitors, regional terminology and industry-specific language.' },
  { id: 'adherence-criteria', q: 'Can we define our own adherence criteria?', a: 'Yes. Teams can configure the pitch points, questions, processes and follow-ups that matter to their sales motion. NeoCore structures captured conversations against those custom fields.' },
  { id: 'coaching', q: 'How does NeoCore improve coaching?', a: 'It surfaces repeated behaviours, missed steps and execution gaps across representatives and teams, helping managers focus coaching on specific evidence rather than occasional observation.' },
  { id: 'integrations', q: 'Can NeoCore integrate with our existing systems?', a: 'Yes. APIs and MCP can connect NeoCore with CRM, BI and other enterprise workflows. The precise integration scope is agreed during the pilot.' },
  { id: 'data-handling', q: 'How is enterprise data handled?', a: 'NeoCore is ISO 27001 certified, does not store audio by default, does not train models on customer data and uses India-resident servers. PII redaction and role-based access can be configured for the deployment.' },
  { id: 'pilot', q: 'What does an enterprise pilot include?', a: 'A pilot defines the team, use case and success measures; configures company terminology and custom fields; deploys capture; measures results; and produces a rollout recommendation.' },
];
---

<section id="faq" class="fold faq">
  <div class="shell faq__grid">
    <div class="fold-head reveal">
      <h2 class="h2">Questions, <span class="b">answered.</span></h2>
      <p class="lede">Product, deployment and integration questions for evaluation.</p>
    </div>
    <div class="faq__list reveal">
      {faqs.map((f) => (
        <details class="faq__item" open={f.open}>
          <summary class="faq__q" data-evt="faq_expand" data-evt-source={f.id}>
            <span>{f.q}</span><span class="faq__icon" aria-hidden="true"></span>
          </summary>
          <div class="faq__a"><p>{f.a}</p></div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq__grid { display: grid; grid-template-columns: 0.8fr 1.7fr; gap: clamp(28px, 5vw, 72px); align-items: start; }
  .faq__list { display: grid; }
  .faq__item { border-bottom: 1px solid var(--hair); }
  .faq__q { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 24px 0; cursor: pointer; list-style: none; font-size: clamp(1.15rem, 1.5vw, 1.4rem); font-weight: 400; letter-spacing: -0.01em; }
  .faq__q::-webkit-details-marker { display: none; }
  .faq__q:hover { color: var(--green-text); }
  .faq__icon { position: relative; width: 18px; height: 18px; flex: none; }
  .faq__icon::before, .faq__icon::after { content: ""; position: absolute; background: var(--ink-2); border-radius: 2px; transition: transform .3s var(--ease), background .2s var(--ease); }
  .faq__icon::before { left: 0; right: 0; top: 8px; height: 2px; }
  .faq__icon::after { top: 0; bottom: 0; left: 8px; width: 2px; }
  .faq__item[open] .faq__icon::after { transform: rotate(90deg); }
  .faq__item[open] .faq__icon::before { background: var(--green); }
  .faq__a { padding: 0 0 26px; }
  .faq__a p { color: var(--ink-2); font-size: 1.05rem; line-height: 1.6; max-width: 64ch; }
  @media (max-width: 820px) { .faq__grid { grid-template-columns: 1fr; } }
</style>
