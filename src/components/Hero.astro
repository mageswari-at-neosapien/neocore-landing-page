---
// Fold 1 — Hero. One live conversation → floating insight, linked by threads.
---

<section id="top" class="hero">
  <div class="shell hero__grid">
    <div class="hero__copy reveal">
      <h1 class="display hero__h">
        Make frontline sales conversations
        <span class="mark">visible<svg viewBox="0 0 200 12" preserveAspectRatio="none" aria-hidden="true"><path d="M3 8 C 50 2, 150 2, 197 7"/></svg></span>,
        <span class="b">measurable</span> and actionable.
      </h1>
      <p class="lede hero__lede">
        Measure pitch adherence, identify coaching priorities and hear the Voice of
        Customer, across teams, regions and languages.
      </p>
      <div class="hero__cta">
        <button type="button" class="pill pill-lg" data-lead-open data-evt="hero_cta_click" data-evt-source="hero">
          Book a demo <span class="ico" aria-hidden="true">→</span>
        </button>
      </div>
    </div>

    <div class="stage reveal" aria-label="The NeoSapien Neo One device, a wearable pendant that captures frontline conversations, shown in graphite and gold">
      <span class="prod__glow" aria-hidden="true"></span>
      <img class="prod__img" src="/neo1-necklace.webp" alt="The NeoSapien Neo One device, a wearable pendant that captures frontline conversations" width="1242" height="1560" fetchpriority="high" decoding="async" />
    </div>
  </div>
</section>

<style>
  .hero { position: relative; overflow: hidden; }
  .hero__grid { display: grid; grid-template-columns: 1.02fr 0.98fr; gap: 30px; align-items: center; }
  .hero__h { margin-top: 18px; max-width: 14ch; font-size: clamp(2.5rem, 4.4vw, 4rem); }
  .hero__lede { margin-top: 20px; }
  .hero__cta { display: flex; align-items: center; gap: 26px; margin-top: 28px; flex-wrap: wrap; }

  .stage { position: relative; height: 560px; }
  .prod__glow { position: absolute; left: 40%; top: 42%; transform: translate(-50%, -50%); width: 92%; aspect-ratio: 1; border-radius: 50%; z-index: 0;
    background: radial-gradient(circle, var(--green-glow), transparent 60%); filter: blur(26px); }
  .prod__img { position: absolute; inset: 0; margin: auto; height: 100%; width: 100%; object-fit: contain; object-position: center; z-index: 1;
    filter: drop-shadow(0 30px 44px rgba(0,0,0,.28)); will-change: transform; }
  /* gentle suspended float + soft glow breathing */
  @media (prefers-reduced-motion: no-preference) {
    .prod__img { animation: heroFloat 7s ease-in-out infinite; }
    .prod__glow { animation: heroGlow 7s ease-in-out infinite; }
  }
  @keyframes heroFloat { 0%, 100% { transform: translateY(0) rotate(0deg); } 50% { transform: translateY(-14px) rotate(-1.6deg); } }
  @keyframes heroGlow { 0%, 100% { opacity: .75; transform: translate(-50%, -50%) scale(1); } 50% { opacity: 1; transform: translate(-50%, -50%) scale(1.07); } }

  @media (max-width: 980px) {
    .hero__grid { grid-template-columns: 1fr; gap: 24px; }
    .stage { height: 440px; margin-top: 8px; }
  }
  @media (max-width: 560px) {
    .stage { height: 380px; }
    .pill-lg { width: 100%; justify-content: space-between; }
  }
</style>
