---
// Fold 1 — Hero. Copy left (45), NeoCore management view right (55).
// The dashboard is the hero object; the Neo One capture signal is a small
// input feeding it from the left edge. All dashboard data is synthetic.
const regions = [
  { name: 'West', value: 87, live: true },
  { name: 'North', value: 79, live: false },
  { name: 'South', value: 74, live: false },
  { name: 'East', value: 68, live: false },
];

const coaching = [
  { title: 'Objection handling — pricing', meta: '34 reps', flagged: true },
  { title: 'Discovery questions skipped', meta: '26 reps', flagged: false },
  { title: 'Next-step commitment missing', meta: '18 reps', flagged: false },
];

const themes = [
  { label: 'Competitor margin pressure', count: '218' },
  { label: 'Delivery timelines', count: '164' },
  { label: 'Financing options', count: '97' },
];
---

<section id="hero" class="hero">
  <div class="container hero__grid">
    <div class="hero__copy">
      <p class="hero__eyebrow mono-label">NeoCore for Enterprise</p>
      <h1 class="hero__title display-xl">
        Make frontline sales conversations visible, measurable and actionable.
      </h1>
      <p class="hero__desc lede">
        Measure pitch adherence, identify coaching priorities and hear the Voice of Customer —
        across teams, regions and languages.
      </p>
      <div class="hero__actions">
        <button
          class="btn btn--primary"
          data-open-form
          data-evt="hero_cta_click"
          data-evt-source="hero"
        >
          Talk to our enterprise team
        </button>
        <a
          class="text-link hero__secondary"
          href="#sample-analysis"
          data-evt="hero_sample_click"
          data-evt-source="hero">See a sample analysis</a
        >
      </div>
      <ul class="hero__proof mono-label">
        <li>140+ languages</li>
        <li>Under 2-minute processing</li>
        <li>ISO 27001 certified</li>
      </ul>
    </div>

    <div class="hero__viz">
      <!-- Neo One capture signal: the input, not the subject -->
      <div class="feed">
        <span class="feed__source">
        <span class="feed__glyph">
          <svg viewBox="0 0 32 32" width="30" height="30" fill="none" aria-hidden="true">
            <path
              d="M12 9c0-4.2 8-4.2 8 0"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"></path>
            <rect
              x="9.75"
              y="9.25"
              width="12.5"
              height="17.5"
              rx="4.5"
              style="fill: var(--g-900)"
              stroke="currentColor"
              stroke-width="1.5"></rect>
            <circle
              cx="16"
              cy="16.5"
              r="2.4"
              style="stroke: var(--green)"
              stroke-width="1.5"></circle>
            <path
              d="M13.2 22.4h5.6"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"></path>
          </svg>
        </span>
        <span class="feed__label mono-label">Neo One capture</span>
        </span>
        <span class="feed__line" aria-hidden="true"></span>
      </div>

      <!-- The dashboard is the fold's one light source: bloom hangs behind it -->
      <div class="hero__stage bloom">
        <div class="dash panel panel--raised">
          <div class="dash__bar">
            <span class="dash__brand">
              <svg viewBox="0 0 18 18" width="16" height="16" fill="none" aria-hidden="true">
                <rect
                  x="1.75"
                  y="1.75"
                  width="14.5"
                  height="14.5"
                  rx="4"
                  stroke="currentColor"
                  stroke-width="1.5"></rect>
                <path
                  d="M6 11.5V6.5l6 5V6.5"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
              NeoCore
            </span>
            <span class="dash__sep" aria-hidden="true"></span>
            <span class="dash__view">Sales conversation intelligence</span>
            <span class="dash__filters">
              <span class="dash__chip mono-label">All India</span>
              <span class="dash__chip mono-label">Last 30 days</span>
            </span>
            <span class="dash__live mono-label">
              <span class="dash__dot" aria-hidden="true"></span>Live
            </span>
          </div>

          <div class="dash__block">
            <div class="dash__head">
              <p class="dash__h">Pitch adherence by region</p>
              <p class="dash__meta mono-value">4,182 conversations · target 80%</p>
            </div>
            <div class="bars">
              <span class="bars__grid" aria-hidden="true">
                <span class="bars__line" style="--x: 25%"></span>
                <span class="bars__line" style="--x: 50%"></span>
                <span class="bars__line" style="--x: 75%"></span>
                <span class="bars__target" style="--x: 80%"></span>
              </span>
              {
                regions.map((r) => (
                  <div class={`bar${r.live ? ' bar--live' : ''}`} style={`--v: ${r.value}%`}>
                    <span class="bar__name">{r.name}</span>
                    <span class="bar__track">
                      <span class="bar__fill" />
                    </span>
                    <span class="bar__val mono-value">{r.value}%</span>
                  </div>
                ))
              }
            </div>
            <div class="bars__axis mono-label" aria-hidden="true">
              <span class="bars__tick bars__tick--start">0</span>
              <span class="bars__tick bars__tick--mid">50</span>
              <span class="bars__tick bars__tick--end">100</span>
            </div>
          </div>

          <div class="dash__block">
            <div class="dash__head">
              <p class="dash__h">Coaching priorities</p>
              <p class="dash__meta mono-value">This week</p>
            </div>
            <ul class="coach">
              {
                coaching.map((c) => (
                  <li class={`coach__row${c.flagged ? ' coach__row--flag' : ''}`}>
                    <span class="coach__icon">
                      {c.flagged ? (
                        <svg viewBox="0 0 16 16" width="15" height="15" fill="none" aria-hidden="true">
                          <path
                            d="M8 2.4 15 14H1L8 2.4Z"
                            stroke="currentColor"
                            stroke-width="1.5"
                            stroke-linejoin="round"
                          />
                          <path
                            d="M8 6.6v3"
                            stroke="currentColor"
                            stroke-width="1.5"
                            stroke-linecap="round"
                          />
                          <path
                            d="M8 11.9v.1"
                            stroke="currentColor"
                            stroke-width="1.5"
                            stroke-linecap="round"
                          />
                        </svg>
                      ) : (
                        <svg viewBox="0 0 16 16" width="15" height="15" fill="none" aria-hidden="true">
                          <circle cx="8" cy="8" r="3.1" stroke="currentColor" stroke-width="1.5" />
                        </svg>
                      )}
                    </span>
                    <span class="coach__name">{c.title}</span>
                    <span class="coach__meta mono-value">{c.meta}</span>
                  </li>
                ))
              }
            </ul>
          </div>

          <div class="dash__block">
            <div class="dash__head">
              <p class="dash__h">Emerging Voice of Customer themes</p>
              <p class="dash__meta mono-value">Mentions</p>
            </div>
            <ul class="voc">
              {
                themes.map((t) => (
                  <li class="voc__chip">
                    <span class="voc__label">{t.label}</span>
                    <span class="voc__count mono-value">{t.count}</span>
                  </li>
                ))
              }
            </ul>
          </div>

          <div class="dash__foot">
            <span class="illustrative-tag">Illustrative view</span>
            <span class="dash__meta mono-value">12 teams · rolling 30 days</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    /* Own stacking context so the dashboard's bloom (z-index: -1) lands above
       the hero ground instead of behind it. */
    isolation: isolate;
    background: var(--g-950);
    padding-block: clamp(28px, 4vw, 60px) clamp(52px, 7vw, 96px);
    overflow: hidden;
  }

  .hero__grid {
    display: grid;
    gap: clamp(36px, 5vw, 56px);
    align-items: center;
  }

  /* ---------- Copy column ---------- */

  .hero__eyebrow {
    color: var(--green-soft);
    /* Tight lockup: the label belongs to the headline, not to the space above it */
    margin-bottom: 10px;
  }

  .hero__title {
    /* Long 8-word mandated headline: cap below display-xl's max so it sets
       in 4–5 lines and the CTA + proof line stay inside a 900px viewport. */
    /* 3.25rem cap: at 3.5rem the 45% column re-orphans "Make" on its own
       line — the known-good four-line set beats 0.25rem of scale. */
    font-size: clamp(2.5rem, 4vw, 3.25rem);
    max-width: 24ch;
  }

  .hero__desc {
    margin-top: 20px;
    max-width: 46ch;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 26px;
    /* Decisive gap: the ask stands apart from the argument */
    margin-top: clamp(32px, 3.8vw, 46px);
  }

  .hero__secondary {
    font-size: 0.9375rem;
  }

  .hero__proof {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 14px;
    list-style: none;
    margin: clamp(24px, 2.8vw, 32px) 0 0;
    padding: 0;
    color: var(--ink-3);
    line-height: 1.4;
    /* Three items must hold one line inside the 45% copy column */
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
  }

  /* In the narrow desktop band the column cannot hold one line: stack as
     rows (mobile's pattern) instead of wrapping past a dangling divider. */
  @media (min-width: 1000px) and (max-width: 1139px) {
    .hero__proof {
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
    }

    .hero__proof li:not(:last-child)::after {
      display: none;
    }
  }

  .hero__proof li {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  /* Trailing divider: a wrapped line never opens with a stray separator */
  .hero__proof li:not(:last-child)::after {
    content: '';
    width: 1px;
    height: 11px;
    background: var(--line-strong);
  }

  /* ---------- Neo One capture feed ---------- */

  .hero__viz {
    display: grid;
    gap: 14px;
    min-width: 0;
  }

  /* The fold's single light source: a soft field behind the instrument, so the
     light reads as coming out of the intelligence. Nothing else is washed. */
  .hero__stage {
    min-width: 0;
    /* Geometry is tuned so the falloff completes inside the fold: no hard
       clipped edge under the sticky header or at the section seam. */
    --bloom-w: 84%;
    --bloom-h: 52%;
    --bloom-x: 54%;
    --bloom-y: 40%;
    --bloom-alpha: 0.14;
    --bloom-spread: clamp(48px, 8vw, 140px);
  }

  .feed {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--ink-2);
  }

  .feed__source {
    flex: none;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .feed__glyph {
    flex: none;
    display: flex;
  }

  .feed__line {
    position: relative;
    flex: 1;
    min-width: 24px;
    height: 1px;
    background-image: linear-gradient(90deg, transparent, var(--green), transparent),
      linear-gradient(90deg, var(--line), var(--line-strong));
    background-size: 80px 1px, 100% 1px;
    background-repeat: no-repeat;
    background-position: calc(0% - 80px) 0, 0 0;
    /* The capture signal crosses twice, then the line settles to a plain
       hairline — motion introduces the mechanism, it does not loop forever. */
    animation: feed-travel 4.2s linear 2;
  }

  .feed__line::after {
    content: '';
    position: absolute;
    right: -2px;
    top: -2px;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--green-dim);
  }

  /* The travelling signal carries its own light; the settled hairline does not. */
  @keyframes feed-travel {
    0% {
      background-position: calc(0% - 80px) 0, 0 0;
      filter: drop-shadow(0 0 5px rgba(63, 224, 124, 0.45));
    }
    70% {
      background-position: calc(100% + 80px) 0, 0 0;
      filter: drop-shadow(0 0 5px rgba(63, 224, 124, 0.45));
    }
    100% {
      background-position: calc(100% + 80px) 0, 0 0;
      filter: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .feed__line {
      animation: none;
    }
  }

  .feed__label {
    flex: none;
    font-size: 0.6875rem;
    color: var(--ink-3);
  }

  /* ---------- Dashboard ---------- */

  .dash {
    overflow: hidden;
    min-width: 0;
  }

  /* Chrome rails sit above the panel ground and take the room's light on their
     top edge; the data grounds below them are recessed and darker. */
  .dash__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 12px;
    padding: 12px 18px;
    background: var(--g-850);
    border-bottom: 1px solid var(--line-strong);
    box-shadow: inset 0 1px 0 rgba(242, 248, 240, 0.07);
  }

  .dash__brand {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 0.875rem;
    font-weight: 620;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .dash__sep {
    width: 1px;
    height: 14px;
    background: var(--line-strong);
  }

  /* Held at 13px: the chrome label must not push the toolbar into a second row */
  .dash__view {
    font-size: 0.8125rem;
    color: var(--ink-2);
  }

  .dash__filters {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-left: auto;
  }

  .dash__chip {
    font-size: 0.625rem;
    letter-spacing: 0.07em;
    color: var(--ink-2);
    border: 1px solid var(--line);
    border-radius: var(--r-s);
    padding: 3px 8px;
    white-space: nowrap;
  }

  .dash__live {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.625rem;
    letter-spacing: 0.07em;
    color: var(--ink-2);
    /* When the chrome bar wraps, the status keeps the right edge instead
       of stranding at a wrapped row's left. */
    margin-left: auto;
  }

  .dash__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--green);
    /* The only genuinely emissive pixel in the chrome */
    box-shadow: 0 0 0 3px var(--green-glow), 0 0 12px 3px var(--green-glow);
  }

  .dash__block {
    --name-w: 52px;
    --val-w: 40px;
    --col-gap: 12px;
    --well-pad: 11px;
    padding: 18px;
  }

  /* Engraved seam: dark line with a catch-light directly beneath it */
  .dash__block + .dash__block {
    border-top: 1px solid var(--line);
    box-shadow: inset 0 1px 0 rgba(242, 248, 240, 0.07);
  }

  .dash__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 4px 12px;
    margin-bottom: 14px;
  }

  .dash__h {
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: -0.005em;
    color: var(--ink);
  }

  .dash__meta {
    font-size: 0.6875rem;
    color: var(--ink-3);
    white-space: nowrap;
  }

  /* ---------- Adherence bars ---------- */

  /* Recessed chart well: the reading surface is cut into the panel */
  .bars {
    position: relative;
    display: grid;
    grid-template-columns: var(--name-w) minmax(0, 1fr) var(--val-w);
    column-gap: var(--col-gap);
    row-gap: 10px;
    align-items: center;
    padding: var(--well-pad);
    border-radius: var(--r-s);
    background: var(--g-900);
    box-shadow: inset 0 0 0 1px var(--line), inset 0 2px 6px -2px rgba(2, 8, 5, 0.7);
  }

  .bars__grid {
    position: absolute;
    top: 0;
    bottom: 0;
    /* Offsets measure from the well's padding box, so they carry --well-pad */
    left: calc(var(--well-pad) + var(--name-w) + var(--col-gap));
    right: calc(var(--well-pad) + var(--val-w) + var(--col-gap));
    z-index: 2;
    pointer-events: none;
  }

  .bars__line,
  .bars__target {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--x);
    width: 1px;
  }

  .bars__line {
    background: var(--line);
  }

  .bars__target {
    background-image: linear-gradient(
      to bottom,
      var(--ink-3) 0 3px,
      transparent 3px 7px
    );
    background-size: 1px 7px;
    background-repeat: repeat-y;
    opacity: 0.7;
  }

  .bar {
    display: contents;
  }

  .bar__name {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--ink-2);
  }

  .bar__track {
    position: relative;
    height: 10px;
    border-radius: 2px;
    background: var(--g-950);
    box-shadow: inset 0 0 0 1px var(--line), inset 0 1px 2px rgba(2, 8, 5, 0.7);
  }

  .bar__fill {
    position: absolute;
    inset: 0 auto 0 0;
    width: var(--v);
    border-radius: 2px;
    background: var(--ink-2);
  }

  /* The live series is lit; the rest are read off the same well */
  .bar--live .bar__fill {
    background: var(--green);
    box-shadow: 0 0 10px rgba(63, 224, 124, 0.45);
  }

  .bar__val {
    font-size: 0.875rem;
    color: var(--ink-2);
    text-align: right;
  }

  .bar--live .bar__val {
    color: var(--green);
  }

  .bars__axis {
    position: relative;
    height: 14px;
    margin: 8px calc(var(--val-w) + var(--col-gap) + var(--well-pad)) 0
      calc(var(--name-w) + var(--col-gap) + var(--well-pad));
    font-size: 0.625rem;
    color: var(--ink-3);
  }

  .bars__tick {
    position: absolute;
    top: 0;
  }

  .bars__tick--start {
    left: 0;
  }

  .bars__tick--mid {
    left: 50%;
    transform: translateX(-50%);
  }

  .bars__tick--end {
    right: 0;
  }

  /* ---------- Coaching priorities ---------- */

  .coach {
    list-style: none;
    margin: 0;
    padding: 3px var(--well-pad);
    display: grid;
    row-gap: 1px;
    border-radius: var(--r-s);
    background: var(--g-900);
    box-shadow: inset 0 0 0 1px var(--line), inset 0 2px 6px -2px rgba(2, 8, 5, 0.7);
  }

  .coach__row {
    display: grid;
    grid-template-columns: 15px minmax(0, 1fr) max-content;
    align-items: center;
    gap: 10px;
    padding: 8px 0;
    color: var(--ink-3);
  }

  .coach__row + .coach__row {
    border-top: 1px solid var(--line);
  }

  .coach__row--flag {
    color: var(--signal-warn);
  }

  .coach__icon {
    display: flex;
  }

  .coach__name {
    font-size: 0.875rem;
    line-height: 1.35;
    color: var(--ink);
  }

  .coach__meta {
    font-size: 0.75rem;
    color: var(--ink-2);
  }

  /* ---------- Voice of Customer ---------- */

  .voc {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  /* Chips read as recessed data, not raised chrome */
  .voc__chip {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 7px 11px;
    border: 1px solid var(--line);
    border-radius: var(--r-s);
    background: var(--g-900);
  }

  .voc__label {
    font-size: 0.75rem;
    color: var(--ink-2);
  }

  .voc__count {
    font-size: 0.75rem;
    color: var(--ink);
    padding-left: 9px;
    border-left: 1px solid var(--line);
  }

  /* ---------- Panel foot ---------- */

  .dash__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 12px;
    padding: 12px 18px;
    background: var(--g-850);
    border-top: 1px solid var(--line-strong);
    box-shadow: inset 0 1px 0 rgba(242, 248, 240, 0.07);
  }

  /* ---------- Responsive ---------- */

  @media (max-width: 640px) {
    .hero__title {
      font-size: clamp(2rem, 8.2vw, 2.5rem);
      max-width: 17ch;
    }

    .hero__eyebrow {
      margin-bottom: 9px;
    }

    .hero__desc {
      margin-top: 16px;
      font-size: 1rem;
    }

    .hero__actions {
      margin-top: 26px;
    }

    .hero__actions .btn {
      width: 100%;
    }

    .hero__proof {
      margin-top: 20px;
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
    }

    .hero__proof li:not(:last-child)::after {
      display: none;
    }

    /* Light stays proportional to the object: a smaller instrument, less spill */
    .hero__stage {
      --bloom-alpha: 0.1;
      --bloom-spread: 44px;
    }

    .dash__view {
      display: none;
    }

    .dash__sep {
      display: none;
    }

    .dash__bar,
    .dash__foot {
      padding: 12px 14px;
    }

    .dash__block {
      --well-pad: 9px;
      padding: 15px 14px;
    }

    .coach__meta {
      font-size: 0.6875rem;
    }
  }

  @media (min-width: 1000px) {
    .hero__grid {
      grid-template-columns: minmax(0, 45fr) minmax(0, 55fr);
      gap: clamp(40px, 4.6vw, 68px);
    }

    /* The input rail gives width back to the subject: the instrument runs
       wider in its column, Neo One stays a label-sized inlet. */
    .hero__viz {
      grid-template-columns: clamp(48px, 4.2vw, 68px) minmax(0, 1fr);
      align-items: center;
      gap: 0;
    }

    .feed {
      grid-column: 1;
      grid-row: 1;
      margin-right: -1px;
    }

    .feed__source {
      flex-direction: column;
      gap: 8px;
    }

    .feed__label {
      font-size: 0.625rem;
      width: min-content;
      text-align: center;
      line-height: 1.4;
    }

    .hero__stage {
      grid-column: 2;
      grid-row: 1;
    }
  }
</style>
