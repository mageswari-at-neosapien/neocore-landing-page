---
// Fold — Industry segments & use-cases, as an interactive selector (list → detail).
const sectors = [
  { n: 'Automotive', tag: 'Showroom & service', icon: 'car', c: 'Capture showroom and service-bay conversations to see which objections stall deals and which service recommendations convert, with advisor-level coaching fed back to the DMS.', sig: ['Objection handling', 'Service conversions', 'Advisor coaching → DMS'] },
  { n: 'FMCG', tag: 'Retailer visits', icon: 'cart', c: 'Record retailer visits across the beat plan to surface stock objections, competitor activity and scheme comprehension, converting top-performer behaviour into targeted frontline coaching.', sig: ['Stock objections', 'Competitor activity', 'Scheme comprehension'] },
  { n: 'Retail', tag: 'In-store', icon: 'store', c: 'Capture in-store customer conversations to understand what shoppers ask for, reject and compare, routing product gaps and pitch-quality insights to category and store-ops teams.', sig: ['Shopper intent', 'Product gaps', 'Pitch quality'] },
  { n: 'BFSI', tag: 'Sales · service · collections', icon: 'bank', c: 'Capture insurance and loan sales conversations for disclosure quality and objection patterns, branch and teller interactions for service quality, and collections calls for conduct adherence and promise-to-pay capture.', sig: ['Disclosure quality', 'Objection patterns', 'Promise-to-pay'] },
  { n: 'Healthcare providers', tag: 'Consultations', icon: 'health', c: 'Capture doctor–patient consultations and convert them into structured clinical notes without screen time during the visit, with structured output available via API for EHR ingestion.', sig: ['Structured clinical notes', 'EHR via API', 'Screen-free capture'] },
  { n: 'Pharma', tag: 'Detailing', icon: 'pharma', c: 'Capture rep-to-prescriber detailing conversations to track which claims are used, which are challenged and where messaging drifts from approved content, feeding territory-level patterns to MR coaching and brand teams.', sig: ['Claim usage', 'Message drift', 'Territory patterns'] },
  { n: 'Government', tag: 'Field & citizen-facing', icon: 'gov', c: 'Capture field and citizen-facing interactions to create an auditable record of what was said, committed and escalated, doubling as a personal productivity layer that converts meetings and site visits into notes and actions.', sig: ['Auditable record', 'Commitments & escalations', 'Meetings → actions'] },
  { n: 'Education', tag: 'Classroom & parent-teacher', icon: 'edu', c: 'Capture classroom and parent-teacher conversations to assess engagement, instruction quality and follow-through on commitments, giving academic leadership visibility into teaching practice without classroom observers.', sig: ['Engagement', 'Instruction quality', 'Follow-through'] },
];
const icons: Record<string, string> = {
  car: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 13l1.8-4.6A2 2 0 0 1 6.7 7h10.6a2 2 0 0 1 1.9 1.4L21 13v5h-3v-2H6v2H3z"/><circle cx="7" cy="16" r="1.3"/><circle cx="17" cy="16" r="1.3"/></svg>',
  cart: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 4h2l2.2 11.2a1.5 1.5 0 0 0 1.5 1.2h8a1.5 1.5 0 0 0 1.5-1.2L21 7H6"/><circle cx="9" cy="20" r="1.2"/><circle cx="18" cy="20" r="1.2"/></svg>',
  store: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 9V7l1.5-3h13L20 7v2a2.5 2.5 0 0 1-4 2 2.5 2.5 0 0 1-4 0 2.5 2.5 0 0 1-4 0 2.5 2.5 0 0 1-4-2z"/><path d="M5 11v9h14v-9"/><path d="M10 20v-5h4v5"/></svg>',
  bank: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-5 9 5"/><path d="M5 9v8M9 9v8M15 9v8M19 9v8"/><path d="M3 20h18"/></svg>',
  health: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20.5C6.5 16.5 4 13.2 4 9.8A4.3 4.3 0 0 1 12 7a4.3 4.3 0 0 1 8 2.8c0 3.4-2.5 6.7-8 10.7z"/><path d="M9 11h6M12 8v6"/></svg>',
  pharma: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3.5" y="9" width="17" height="6" rx="3" transform="rotate(45 12 12)"/><path d="M9.7 9.7l4.6 4.6"/></svg>',
  gov: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-5 9 5"/><path d="M4 9h16"/><path d="M6 9v8M10 9v8M14 9v8M18 9v8"/><path d="M4 20h16"/></svg>',
  edu: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4L2 9l10 5 8-4v6"/><path d="M6 12v4c0 1 2.7 2.5 6 2.5s6-1.5 6-2.5v-4"/></svg>',
};
---

<section id="industries" class="fold ind">
  <div class="shell">
    <div class="fold-head reveal">
      <p class="tag">Industry segments</p>
      <h2 class="h2">One capture layer, <span class="b">use-cases across every field team.</span></h2>
      <p class="lede">NeoCore adapts to the conversations that drive each sector, from showroom floors to prescriber visits, and routes the right intelligence to the right teams.</p>
    </div>

    <div class="ind__panel" data-ind>
      <div class="ind__tabs" role="tablist" aria-label="Industry segments">
        {sectors.map((s, i) => (
          <button type="button" class="itab" class:list={[{ 'is-active': i === 0 }]} role="tab" aria-selected={i === 0 ? 'true' : 'false'} aria-expanded={i === 0 ? 'true' : 'false'} data-i={i}>
            <span class="itab__ic" aria-hidden="true" set:html={icons[s.icon]} />
            <span class="itab__n">{s.n}</span>
            <span class="itab__go" aria-hidden="true">→</span>
          </button>
        ))}
      </div>

      <div class="ind__detail">
        {sectors.map((s, i) => (
          <article class="idetail" class:list={[{ 'is-active': i === 0 }]} data-i={i}>
            <span class="idetail__ic" aria-hidden="true" set:html={icons[s.icon]} />
            <span class="idetail__tag">{s.tag}</span>
            <h3 class="idetail__n">{s.n}</h3>
            <p class="idetail__c">{s.c}</p>
            <div class="idetail__sig">
              <span class="idetail__siglbl">What NeoCore surfaces</span>
              <div class="idetail__chips">
                {s.sig.map((x) => <span class="ichip">{x}</span>)}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .ind .fold-head { max-width: 820px; }
  .ind .fold-head .h2 { margin-top: 12px; }
  .ind .fold-head .lede { margin-top: 18px; }

  .ind__panel { margin-top: clamp(30px, 4vw, 48px); display: grid; grid-template-columns: 0.82fr 1.18fr; gap: clamp(16px, 2.4vw, 32px); align-items: start; }

  /* left — sector selector list */
  .ind__tabs { list-style: none; display: grid; gap: 4px; }
  .itab { display: flex; align-items: center; gap: 13px; padding: 12px 14px; border-radius: var(--r-m); cursor: pointer;
    appearance: none; -webkit-appearance: none; background: none; font: inherit; text-align: left; width: 100%;
    border: 1px solid transparent; color: var(--ink-2); transition: background .2s var(--ease), color .2s var(--ease), border-color .2s var(--ease); }
  .itab:not(.is-active):hover { background: color-mix(in srgb, var(--green) 5%, transparent); color: var(--ink); }
  .itab.is-active { background: var(--surface); border-color: color-mix(in srgb, var(--green) 24%, var(--hair)); color: var(--ink); box-shadow: var(--shadow-1); }
  .itab:focus-visible { outline: 2px solid var(--green); outline-offset: 2px; }
  .itab__ic { width: 34px; height: 34px; border-radius: 10px; flex: none; display: grid; place-items: center; color: var(--green-text);
    background: color-mix(in srgb, var(--green) 10%, transparent); transition: background .2s var(--ease); }
  .itab.is-active .itab__ic { background: color-mix(in srgb, var(--green) 16%, var(--surface)); }
  .itab__ic :global(svg) { width: 19px; height: 19px; }
  .itab__n { font-size: 1rem; font-weight: 500; letter-spacing: -0.01em; flex: 1; }
  .itab__go { color: var(--green-text); opacity: 0; transform: translateX(-4px); transition: opacity .2s var(--ease), transform .2s var(--ease); }
  .itab.is-active .itab__go { opacity: 1; transform: none; }

  /* right — active sector detail */
  .ind__detail { position: relative; background: var(--surface); border: 1px solid var(--hair); border-radius: var(--r-l); padding: clamp(28px, 3.4vw, 44px); box-shadow: var(--shadow-2); min-height: 100%; overflow: hidden; }
  .ind__detail::before { content: ""; position: absolute; right: -12%; top: -30%; width: 340px; height: 340px; border-radius: 50%; pointer-events: none;
    background: radial-gradient(circle, var(--green-glow), transparent 66%); filter: blur(20px); opacity: .8; }
  .idetail { position: relative; display: none; }
  .idetail.is-active { display: flex; flex-direction: column; justify-content: center; height: 100%; animation: idIn .34s var(--ease); }
  @keyframes idIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
  .idetail__ic { width: 60px; height: 60px; border-radius: 17px; display: grid; place-items: center; color: var(--green-text);
    background: color-mix(in srgb, var(--green) 12%, var(--surface)); border: 1px solid color-mix(in srgb, var(--green) 26%, transparent);
    box-shadow: 0 14px 30px -14px var(--green-glow); }
  .idetail__ic :global(svg) { width: 29px; height: 29px; }
  .idetail__tag { display: inline-block; margin-top: 20px; font-size: .68rem; letter-spacing: .07em; text-transform: uppercase; font-weight: 700; color: var(--green-text); }
  .idetail__n { margin-top: 8px; font-size: clamp(1.6rem, 2.6vw, 2.1rem); font-weight: 500; letter-spacing: -0.02em; }
  .idetail__c { margin-top: 16px; color: var(--ink-2); font-size: clamp(1.02rem, 1.2vw, 1.18rem); line-height: 1.55; max-width: 46ch; }
  .idetail__sig { margin-top: 26px; padding-top: 22px; border-top: 1px solid var(--hair); }
  .idetail__siglbl { display: block; font-size: .64rem; letter-spacing: .07em; text-transform: uppercase; font-weight: 700; color: var(--ink-3); margin-bottom: 13px; }
  .idetail__chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .ichip { font-size: .86rem; font-weight: 500; color: var(--ink); background: color-mix(in srgb, var(--green) 8%, var(--surface-2)); border: 1px solid color-mix(in srgb, var(--green) 22%, var(--hair)); border-radius: var(--r-pill); padding: 7px 14px; }

  @media (max-width: 820px) {
    .ind .fold-head { text-align: center; margin-inline: auto; }
    .ind__panel { display: block; }

    /* accordion: full-width tiles; the detail opens directly beneath the active tile */
    .ind__tabs { display: block; }
    .itab { width: 100%; border: 1px solid var(--hair); background: var(--surface); padding: 14px 16px; margin-bottom: 8px; }
    .itab__n { font-size: .98rem; }
    .itab.is-active { border-color: color-mix(in srgb, var(--green) 42%, var(--hair)); border-bottom-color: transparent;
      border-bottom-left-radius: 0; border-bottom-right-radius: 0; margin-bottom: 0; box-shadow: none; }
    .itab.is-active .itab__go { transform: rotate(90deg); }

    /* the detail is moved under the active tile by script → render as the open panel */
    .ind__detail { margin: 0 0 8px; padding: clamp(22px, 6vw, 30px); text-align: center; min-height: 0;
      border-color: color-mix(in srgb, var(--green) 42%, var(--hair)); border-top: none;
      border-top-left-radius: 0; border-top-right-radius: 0; box-shadow: var(--shadow-1); }
    .idetail.is-active { align-items: center; }
    .idetail__ic { margin-inline: auto; }
    .idetail__c { max-width: 52ch; margin-inline: auto; }
    .idetail__sig { width: 100%; }
    .idetail__chips { justify-content: center; }
  }
</style>

<script>
  const panel = document.querySelector<HTMLElement>('[data-ind]');
  if (panel) {
    const tabs = Array.from(panel.querySelectorAll<HTMLElement>('.itab'));
    const details = Array.from(panel.querySelectorAll<HTMLElement>('.idetail'));
    const detailBox = panel.querySelector<HTMLElement>('.ind__detail')!;
    const mq = window.matchMedia('(max-width: 820px)');
    let cur = 0;
    // On mobile, move the detail panel directly beneath the active tile (accordion);
    // on desktop, keep it as the panel's second column.
    const place = () => {
      if (mq.matches) tabs[cur].after(detailBox);
      else panel.appendChild(detailBox);
    };
    const show = (i: number) => {
      cur = i;
      tabs.forEach((t, n) => { const on = n === i; t.classList.toggle('is-active', on); t.setAttribute('aria-selected', String(on)); t.setAttribute('aria-expanded', String(on)); });
      details.forEach((d, n) => d.classList.toggle('is-active', n === i));
      place();
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => show(i));
      t.addEventListener('mouseenter', () => { if (!mq.matches) show(i); });
      t.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); show(i); }
        if (e.key === 'ArrowDown' || e.key === 'ArrowRight') { e.preventDefault(); const n = (i + 1) % tabs.length; tabs[n].focus(); show(n); }
        if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') { e.preventDefault(); const n = (i - 1 + tabs.length) % tabs.length; tabs[n].focus(); show(n); }
      });
    });
    mq.addEventListener('change', place);
    place(); // position correctly for the current viewport on load
  }
</script>
