---
// "See what NeoCore produces" — the live NeoCore Sales Intelligence dashboard.
import NeoCoreDashboard from './NeoCoreDashboard.astro';
import NeoCoreProductDashboard from './NeoCoreProductDashboard.astro';
---

<section id="produces" class="fold producesfold glowsec">
  <span class="secglow secglow--bl" aria-hidden="true"></span>
  <div class="shell">
    <div class="produces reveal">
      <div class="produces__head">
        <div>
          <h2 class="h2 produces__h">See what NeoCore <span class="b">produces.</span></h2>
          <p class="produces__desc">Frontline conversations become management dashboards: pitch adherence, coaching priorities and Voice of Customer, ready to act on.</p>
        </div>
        <button type="button" class="ghost produces__demo" data-lead-open data-evt="tailored_demo_click" data-evt-source="produces">See a tailored demo</button>
      </div>

      <div class="dashes2">
        <div class="dcol reveal">
          <NeoCoreProductDashboard />
        </div>
        <div class="dcol reveal">
          <NeoCoreDashboard />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .producesfold { padding-block: clamp(16px, 2.5vw, 30px) 18px; }
  .glowsec { position: relative; overflow: hidden; }
  .secglow { position: absolute; width: 720px; height: 620px; border-radius: 50%; pointer-events: none; z-index: 0;
    background: radial-gradient(circle, var(--green-glow), transparent 66%); filter: blur(30px); opacity: .9; }
  .secglow--bl { left: -16%; bottom: -22%; }
  .glowsec .shell { position: relative; z-index: 1; }

  .produces__head { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; flex-wrap: wrap; margin-bottom: clamp(12px, 1.5vw, 18px); }
  .produces__h { margin-top: 0; }
  .produces__desc { margin-top: 12px; max-width: 54ch; color: var(--ink-2); font-size: clamp(.98rem, 1.1vw, 1.1rem); line-height: 1.45; }
  .dashes2 { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(16px, 2vw, 24px); align-items: stretch; }
  .dcol { display: flex; flex-direction: column; }
  .dcol > :first-child { flex: 1; }

  @media (max-width: 900px) { .dashes2 { grid-template-columns: 1fr; } }
</style>
