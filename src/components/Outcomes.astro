---
/**
 * Fold 4 — Management outcomes, enterprise capabilities, ungated sample analysis.
 * Weighting is mandated by the brief: adherence first, coaching second, Voice of
 * Customer third, with the first two carrying more visual weight (size, elevation
 * and data density) than the third. Every fragment is an instrument reading, not
 * an icon tile; all values are synthetic and internally consistent.
 */

// Card 1 — custom-field coverage across a region. Mean of these five is 76%.
const adherenceFields = [
  { name: 'Opening value proposition', value: 94, flagged: false },
  { name: 'Product margin comparison', value: 88, flagged: false },
  { name: 'Competitor handling', value: 71, flagged: false },
  { name: 'Current retailer scheme', value: 46, flagged: true },
  { name: 'Close and next step', value: 83, flagged: false },
];

// Card 2 — the coaching queue, ranked because the order is the information.
const coachingQueue = [
  { rank: '01', who: 'R. Menon', context: 'North · Missed scheme step', score: '46%', flagged: true },
  { rank: '02', who: 'Team Sharma', context: 'West · Weak margin rebuttal', score: '58%', flagged: false },
  { rank: '03', who: 'A. Iyer', context: 'South · No close attempt', score: '61%', flagged: false },
];

// Card 3 — Voice of Customer themes, counted over a rolling window.
const vocThemes = [
  { name: 'Competitor margin pressure', count: '214', rising: true },
  { name: 'Scheme clarity', count: '168', rising: false },
  { name: 'Stock availability', count: '97', rising: false },
  { name: 'Pack size feedback', count: '64', rising: false },
  { name: 'Credit terms', count: '41', rising: false },
];
---

<section id="outcomes" class="fold fold--lifted" aria-labelledby="outcomes-title">
  <div class="container">
    <div class="fold-head reveal">
      <h2 id="outcomes-title" class="display-l">Turn visibility into better frontline execution.</h2>
      <p class="lede">
        NeoCore makes conversations queryable and comparable, giving leaders the evidence to improve
        how teams sell and learn.
      </p>
    </div>

    <!-- Outcome cards: 7/5 on the top row, a wide low-profile strip beneath. -->
    <div class="outcomes-grid">
      <article class="panel panel--raised card card--lead card--a">
        <h3 class="card-title">Measure pitch adherence</h3>
        <p class="card-copy">
          Define the messages, questions and steps that matter. NeoCore structures each conversation
          against those custom fields and shows where execution is consistent or slipping.
        </p>

        <div class="frag">
          <div class="frag-head">
            <span class="frag-id">
              <span class="mono-label">Custom fields · North region</span>
              <span class="illustrative-tag">Illustrative view</span>
            </span>
            <span class="mono-value frag-metric">76% avg</span>
          </div>
          <ul class="field-rows">
            {
              adherenceFields.map((f) => (
                <li class:list={['field-row', f.flagged && 'is-flagged']}>
                  <span class="field-name">{f.name}</span>
                  <span class="bar" aria-hidden="true">
                    <span class="bar-fill" style={`width:${f.value}%`}></span>
                  </span>
                  <span class="mono-value field-value">{f.value}%</span>
                </li>
              ))
            }
          </ul>
        </div>
      </article>

      <article class="panel panel--raised card card--lead card--b">
        <h3 class="card-title">Coach with evidence</h3>
        <p class="card-copy">
          Identify repeated behaviours and missed steps, then focus coaching on the representatives,
          teams and regions that need it most.
        </p>

        <div class="frag">
          <div class="frag-head">
            <span class="frag-id">
              <span class="mono-label">Coaching queue · this week</span>
              <span class="illustrative-tag">Illustrative view</span>
            </span>
            <span class="mono-value frag-metric">3 flagged</span>
          </div>
          <ol class="queue">
            {
              coachingQueue.map((c) => (
                <li class:list={['queue-row', c.flagged && 'is-flagged']}>
                  <span class="mono-value queue-rank">{c.rank}</span>
                  <span class="queue-body">
                    <span class="queue-who">{c.who}</span>
                    <span class="queue-context">{c.context}</span>
                  </span>
                  <span class="mono-value queue-score">{c.score}</span>
                </li>
              ))
            }
          </ol>
        </div>
      </article>

      <article class="panel card card--voc">
        <div class="voc-copy">
          <h3 class="card-title card-title--sm">Hear the Voice of Customer</h3>
          <p class="card-copy">
            Aggregate objections, competitor mentions, product feedback and emerging market themes
            while they are still actionable.
          </p>
        </div>
        <div class="voc-frag">
          <span class="voc-frag-head">
            <span class="mono-label">Emerging themes · last 30 days</span>
            <span class="illustrative-tag">Illustrative view</span>
          </span>
          <ul class="chips">
            {
              vocThemes.map((t) => (
                <li class:list={['chip', t.rising && 'is-rising']}>
                  {t.rising && (
                    <svg class="chip-tick" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <path
                        d="M6 16.5 11 10l3.5 3.5L19 7.5"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                      <path
                        d="M14.5 7.5H19V12"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  )}
                  <span class="chip-name">{t.name}</span>
                  <span class="mono-value chip-count">{t.count}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </article>
    </div>

    <!-- Enterprise capability rail: a list under a hairline, subordinate by design. -->
    <div class="rail">
      <h3 class="mono-label rail-title">Enterprise capabilities</h3>
      <ul class="rail-list">
        <li class="rail-item">
          <span class="rail-glyph" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <path d="M3 12h1.5M20.5 12H22" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
              <path
                d="M7 8.5v7M11 4.5v15M15 7v10M19 10v4"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
              />
            </svg>
          </span>
          <h4 class="rail-name">Breakthrough technology</h4>
          <p class="rail-copy">
            Multilingual processing, speaker attribution, emotion capture and processing in under two
            minutes.
          </p>
        </li>
        <li class="rail-item">
          <span class="rail-glyph" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <path d="M3 8.5h9M16.5 8.5H21M3 15.5h4.5M12 15.5h9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
              <circle cx="14.25" cy="8.5" r="2.25" stroke="currentColor" stroke-width="1.5" />
              <circle cx="9.75" cy="15.5" r="2.25" stroke="currentColor" stroke-width="1.5" />
            </svg>
          </span>
          <h4 class="rail-name">Tailored to your needs</h4>
          <p class="rail-copy">
            Tune NeoCore for local brands, products, competitors, industry terminology and regional
            sales language.
          </p>
        </li>
        <li class="rail-item">
          <span class="rail-glyph" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <path d="M12 3.5v10.5m0 0 3.75-3.75M12 14l-3.75-3.75" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              <path d="M4 15.5v3a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
            </svg>
          </span>
          <h4 class="rail-name">Built for adoption</h4>
          <p class="rail-copy">
            Friction-light capture minimizes additional administrative work for frontline teams.
          </p>
        </li>
        <li class="rail-item">
          <span class="rail-glyph" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <path d="M8.5 7.5 4 12l4.5 4.5M15.5 7.5 20 12l-4.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              <path d="M13.25 5.5 10.75 18.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
            </svg>
          </span>
          <h4 class="rail-name">API-first</h4>
          <p class="rail-copy">
            Connect NeoCore intelligence with CRM, BI and enterprise workflows through APIs and MCP.
          </p>
        </li>
      </ul>
    </div>

    <!-- Ungated proof: fully readable, never gated. -->
    <div id="sample-analysis" class="sample" data-evt-view="sample_analysis_view">
      <div class="sample-head">
        <h3 class="display-m">See what NeoCore produces.</h3>
        <span class="illustrative-tag">Illustrative synthetic example</span>
      </div>

      <!-- The fold's one light source hangs behind the middle stage: the
           transformation is where the light is. -->
      <div class="flow bloom">
        <article class="panel flow-panel flow-panel--signal">
          <h4 class="mono-label flow-title">Conversation signal</h4>
          <div class="sig-meta">
            <span class="sig-speaker"><span class="sig-dot" aria-hidden="true"></span>Retailer</span>
            <span class="mono-value sig-time">00:04:12</span>
          </div>
          <blockquote class="sig-quote">
            “Brand X offers us a better margin. I can stock this product if your scheme improves.”
          </blockquote>
        </article>

        <div class="flow-link" aria-hidden="true">
          <svg class="flow-arrow" viewBox="0 0 44 12" fill="none">
            <path class="arrow-shaft" d="M0 6h36" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
            <path class="arrow-head" d="m31 1.5 5 4.5-5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </div>

        <article class="panel panel--raised flow-panel flow-panel--core">
          <h4 class="mono-label flow-title">Structured intelligence</h4>
          <dl class="fields">
            <div class="field">
              <dt class="mono-label field-key">Pitch adherence</dt>
              <dd class="mono-value field-val">
                4 of 5 required points covered
                <span class="meter" aria-hidden="true">
                  <span class="meter-seg is-on"></span>
                  <span class="meter-seg is-on"></span>
                  <span class="meter-seg is-on"></span>
                  <span class="meter-seg is-on"></span>
                  <span class="meter-seg is-miss"></span>
                </span>
              </dd>
            </div>
            <div class="field field--warn">
              <dt class="mono-label field-key">Missed topic</dt>
              <dd class="mono-value field-val">
                <svg class="warn-glyph" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <circle cx="12" cy="12" r="7.25" stroke="currentColor" stroke-width="1.5" />
                  <path d="M8.75 12h6.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                </svg>
                Current retailer scheme
              </dd>
            </div>
            <div class="field">
              <dt class="mono-label field-key">Voice of Customer</dt>
              <dd class="mono-value field-val">Competitor margin pressure</dd>
            </div>
          </dl>
        </article>

        <div class="flow-link" aria-hidden="true">
          <svg class="flow-arrow" viewBox="0 0 44 12" fill="none">
            <path class="arrow-shaft" d="M0 6h36" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
            <path class="arrow-head" d="m31 1.5 5 4.5-5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </div>

        <article class="panel flow-panel flow-panel--action">
          <h4 class="mono-label flow-title">Management action</h4>
          <dl class="fields">
            <div class="field">
              <dt class="mono-label field-key">Coaching priority</dt>
              <dd class="field-val field-val--prose">
                <svg class="act-glyph" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="m5 12.5 4.25 4.25L19 7.25" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                Address the margin objection using the approved comparison
              </dd>
            </div>
            <div class="field">
              <dt class="mono-label field-key">Next action</dt>
              <dd class="field-val field-val--prose">
                <svg class="act-glyph" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M4 12h14M13.5 6.5 19 12l-5.5 5.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                Follow up with the updated scheme
              </dd>
            </div>
          </dl>
        </article>
      </div>

      <div class="sample-cta">
        <button class="btn btn--outline" data-open-form data-evt="tailored_demo_click" data-evt-source="sample-analysis">
          See a tailored demo
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  /* ---------- Rhythm ----------
     The fold accelerates: dense at the top, tightening through the rail,
     then opening wide around the sample module so it reads as a stage. */

  #outcomes .fold-head {
    margin-bottom: clamp(32px, 3.8vw, 50px);
  }

  /* ---------- Outcome cards ---------- */

  .outcomes-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(12px, 1.2vw, 16px);
  }

  .card {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .card--a {
    grid-column: span 7;
  }

  .card--b {
    grid-column: span 5;
  }

  .card--voc {
    grid-column: span 12;
  }

  /* Weight lives in size, elevation and density — not in an icon. */
  .card--lead {
    padding: clamp(22px, 2.2vw, 30px);
  }

  /* Third by mandate: a low-profile strip that sits almost flush with the
     fold ground — no elevation to compete with the two lead cards. */
  .outcomes-grid .card--voc {
    padding: clamp(16px, 1.6vw, 22px) clamp(18px, 2vw, 26px);
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    align-items: center;
    gap: clamp(20px, 3vw, 44px);
    background: var(--g-900);
    box-shadow: none;
  }

  .card-title {
    font-size: clamp(1.25rem, 1.7vw, 1.5rem);
    letter-spacing: -0.02em;
  }

  .card-title--sm {
    font-size: clamp(1.125rem, 1.3vw, 1.25rem);
  }

  .card-copy {
    margin-top: 12px;
    color: var(--ink-2);
    font-size: 1rem;
    line-height: 1.55;
    max-width: 46ch;
  }

  .card--voc .card-copy {
    font-size: 0.9375rem;
    margin-top: 10px;
  }

  /* ---------- Shared fragment chrome ---------- */

  .frag {
    --well-pad: clamp(12px, 1.2vw, 16px);
    margin-top: clamp(22px, 2.4vw, 30px);
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }

  /* The fragment sits on the card floor, with a guaranteed gap above it. */
  .card--lead .card-copy {
    margin-bottom: clamp(22px, 2.4vw, 30px);
  }

  .card--lead .frag {
    margin-top: auto;
  }

  .frag-head {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 10px 16px;
    margin-bottom: 14px;
  }

  .frag-id {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
  }

  /* When the head wraps in a narrow card, the measured value still
     anchors to the right edge instead of clustering left. */
  .frag-head .frag-metric {
    margin-left: auto;
  }

  .voc-frag-head {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px 14px;
  }

  .frag-metric {
    font-size: 0.8125rem;
    color: var(--ink-2);
  }

  /* ---------- Card 1: custom-field coverage ---------- */

  .field-rows,
  .queue,
  .chips {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* The readings sit in a well cut into the card floor — instrument, not tile. */
  .field-rows,
  .queue {
    background: var(--g-950);
    border: 1px solid var(--line);
    border-radius: var(--r-s);
    padding: 5px var(--well-pad);
    box-shadow: inset 0 2px 6px -2px rgba(2, 8, 5, 0.9);
  }

  .field-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(64px, 130px) 42px;
    align-items: center;
    gap: 14px;
    padding-block: 9px;
    border-top: 1px solid var(--line);
  }

  .field-row:first-child {
    border-top: 0;
  }

  .field-name {
    font-size: 0.875rem;
    color: var(--ink-2);
    min-width: 0;
  }

  .bar {
    display: block;
    height: 5px;
    border-radius: 999px;
    background: var(--g-950);
    border: 1px solid var(--line-strong);
    overflow: hidden;
  }

  .bar-fill {
    display: block;
    height: 100%;
    background: var(--green-dim);
    box-shadow: inset 0 1px 0 rgba(143, 240, 180, 0.3);
  }

  .field-row .field-value {
    font-size: 0.8125rem;
    color: var(--ink-2);
    text-align: right;
  }

  /* Flagged reading: the wash spans the full well width so the miss is
     legible at a glance, not just in the number. */
  .field-row.is-flagged {
    background: rgba(232, 186, 91, 0.07);
    margin-inline: calc(-1 * var(--well-pad));
    padding-inline: var(--well-pad);
  }

  .field-row.is-flagged .field-name {
    color: var(--ink);
  }

  .field-row.is-flagged .bar-fill {
    background: var(--signal-warn);
    box-shadow: inset 0 1px 0 rgba(242, 248, 240, 0.28);
  }

  .field-row.is-flagged .field-value {
    color: var(--signal-warn);
    font-weight: 600;
  }

  /* ---------- Card 2: coaching queue ---------- */

  .queue-row {
    display: grid;
    grid-template-columns: 24px minmax(0, 1fr) auto;
    align-items: center;
    gap: 14px;
    padding-block: 11px;
    border-top: 1px solid var(--line);
  }

  .queue-row:first-child {
    border-top: 0;
  }

  .queue-rank {
    font-size: 0.75rem;
    color: var(--ink-3);
  }

  .queue-body {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .queue-who {
    font-size: 0.9375rem;
    font-weight: 560;
    letter-spacing: -0.01em;
  }

  .queue-context {
    font-size: 0.8125rem;
    color: var(--ink-3);
  }

  .queue-score {
    font-size: 0.875rem;
    color: var(--ink-2);
  }

  .queue-row.is-flagged {
    background: rgba(232, 186, 91, 0.07);
    margin-inline: calc(-1 * var(--well-pad));
    padding-inline: var(--well-pad);
  }

  .queue-row.is-flagged .queue-rank {
    color: var(--signal-warn);
  }

  .queue-row.is-flagged .queue-score {
    color: var(--signal-warn);
    font-weight: 600;
  }

  /* ---------- Card 3: Voice of Customer themes ---------- */

  .voc-frag > .mono-label {
    display: block;
    margin-bottom: 12px;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--g-950);
  }

  .chip-name {
    font-size: 0.8125rem;
    color: var(--ink-2);
  }

  .chip-count {
    font-size: 0.75rem;
    color: var(--ink-3);
  }

  .chip.is-rising {
    border-color: var(--line-strong);
    background: var(--g-800);
  }

  .chip.is-rising .chip-name {
    color: var(--ink);
  }

  .chip-tick {
    width: 14px;
    height: 14px;
    flex: none;
    color: var(--green);
  }

  /* ---------- Enterprise capability rail ---------- */

  .rail {
    margin-top: clamp(34px, 3.6vw, 52px);
  }

  .rail-title {
    margin-bottom: 12px;
    color: var(--ink-3);
  }

  .rail-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-bottom: 1px solid var(--line);
  }

  .rail-item {
    display: grid;
    grid-template-columns: 22px minmax(170px, 210px) minmax(0, 1fr);
    align-items: center;
    gap: 20px;
    padding-block: 16px;
    border-top: 1px solid var(--line);
  }

  .rail-glyph {
    display: block;
    color: var(--ink-3);
  }

  .rail-glyph svg {
    width: 22px;
    height: 22px;
  }

  .rail-name {
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin: 0;
  }

  .rail-copy {
    font-size: 0.9375rem;
    color: var(--ink-2);
    line-height: 1.5;
    max-width: 68ch;
  }

  /* ---------- Ungated sample analysis ---------- */

  .sample {
    margin-top: clamp(76px, 9vw, 136px);
  }

  .sample-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
    margin-bottom: clamp(26px, 3.2vw, 40px);
  }

  /* The stage. One light source for the whole fold, hung on the middle
     panel: raw speech goes in dark, intelligence comes out lit. */
  .flow {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: stretch;
    /* Own stacking context so the bloom paints above the fold ground. */
    isolation: isolate;
    --bloom-x: 50%;
    --bloom-y: 48%;
    --bloom-w: 58%;
    --bloom-h: 96%;
    --bloom-alpha: 0.13;
    --bloom-spread: clamp(56px, 8vw, 130px);
  }

  .flow-panel {
    padding: clamp(18px, 1.8vw, 24px);
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .flow-title {
    margin-bottom: 14px;
    color: var(--ink-3);
  }

  /* Stage 1 — signal: quiet, nearly the room's own dark. */
  .flow .flow-panel--signal {
    background: var(--g-900);
  }

  /* Stage 2 — the transformation: taller, lit, edged in signal green. */
  .flow .flow-panel--core {
    --panel-pad: clamp(22px, 2.2vw, 30px);
    position: relative;
    z-index: 1;
    padding: var(--panel-pad);
    margin-block: calc(-1 * clamp(6px, 0.9vw, 14px));
    border-color: var(--line-strong);
    background-image: linear-gradient(
      180deg,
      rgba(143, 240, 180, 0.075),
      transparent 160px
    );
    box-shadow: var(--shadow-raised), inset 0 1px 0 rgba(242, 248, 240, 0.1),
