---
// "Turn visibility into better frontline execution" — management outcomes.
const outcomes = [
  {
    n: 'Measure pitch adherence',
    c: 'Define the messages, questions and steps that matter. NeoCore structures each conversation against those custom fields and shows where execution is consistent or slipping.',
    icon: 'target',
  },
  {
    n: 'Coach with evidence',
    c: 'Identify repeated behaviours and missed steps, then focus coaching on the representatives, teams and regions that need it most.',
    icon: 'coach',
  },
  {
    n: 'Hear the Voice of Customer',
    c: 'Aggregate objections, competitor mentions, product feedback and emerging market themes while they are still actionable.',
    icon: 'voice',
  },
];
const icons: Record<string, string> = {
  target: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="12" r="8.5"/><circle cx="12" cy="12" r="4"/><circle cx="12" cy="12" r="0.8" fill="currentColor" stroke="none"/></svg>',
  coach: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5.5h16v10H9l-4 3v-3H4z"/><path d="M8.8 10.4l2 2 3.6-3.6"/></svg>',
  voice: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M4 12h.01M8 8.5v7M12 5v14M16 9v6M20 11v2"/></svg>',
};
---

<section id="outcomes" class="fold out glowsec">
  <span class="secglow secglow--tr" aria-hidden="true"></span>
  <div class="shell out__grid">
    <div class="out__copy reveal">
      <h2 class="h2">Turn visibility into <span class="b">better frontline execution.</span></h2>
      <p class="lede">NeoCore makes conversations queryable and comparable, giving leaders the evidence to improve how teams sell and learn.</p>
      <ul class="olist">
        {outcomes.map((o, i) => (
          <li class="oitem" class:list={[{ 'oitem--lg': i < 2 }]}>
            <span class="iconh iconh--sm" aria-hidden="true" set:html={icons[o.icon]} />
            <div>
              <h3 class="oitem__n">{o.n}</h3>
              <p class="oitem__c">{o.c}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>

    <div class="out__view reveal">
      <figure class="dashph">
        <div class="dashph__bar">
          <span></span><span></span><span></span>
          <em><span class="live" aria-hidden="true"></span>Panasonic Dashboard · live view</em>
        </div>
        <div class="dashph__screen">
          <span class="dashph__note">Dynamic Panasonic dashboard to be embedded here</span>
        </div>
      </figure>
    </div>
  </div>
</section>

<style>
  /* section glow */
  .glowsec { position: relative; overflow: hidden; }
  .secglow { position: absolute; width: 720px; height: 620px; border-radius: 50%; pointer-events: none; z-index: 0;
    background: radial-gradient(circle, var(--green-glow), transparent 66%); filter: blur(30px); opacity: .9; }
  .secglow--tr { right: -14%; top: -18%; }
  .glowsec .shell { position: relative; z-index: 1; }

  .iconh { width: 54px; height: 54px; border-radius: 16px; display: grid; place-items: center; color: var(--green-text);
    background: color-mix(in srgb, var(--green) 12%, var(--surface));
    border: 1px solid color-mix(in srgb, var(--green) 26%, transparent);
    box-shadow: 0 14px 30px -14px var(--green-glow), inset 0 1px 0 rgba(255,255,255,.35); }
  .iconh :global(svg) { width: 26px; height: 26px; }

  /* Outcomes — copy + list on the left, management-view visual on the right */
  .out__grid { display: grid; grid-template-columns: 0.92fr 1.08fr; gap: clamp(32px, 5vw, 72px); align-items: center; }
  .out__copy { max-width: 560px; }
  .olist { margin-top: clamp(24px, 3vw, 38px); display: grid; gap: clamp(18px, 2.2vw, 26px); }
  .oitem { display: flex; gap: 16px; align-items: flex-start; }
  .oitem__n { font-size: 1.15rem; font-weight: 500; letter-spacing: -0.015em; }
  .oitem--lg .oitem__n { font-size: clamp(1.3rem, 1.7vw, 1.55rem); }
  .oitem__c { margin-top: 5px; color: var(--ink-2); font-size: .95rem; line-height: 1.5; }
  .oitem:not(.oitem--lg) .oitem__c { font-size: .9rem; }
  .iconh--sm { width: 46px; height: 46px; border-radius: 13px; flex: none; }
  .iconh--sm :global(svg) { width: 22px; height: 22px; }
  .oitem:not(.oitem--lg) .iconh--sm { width: 40px; height: 40px; }

  /* right-hand image slot — placeholder for the dynamic Panasonic dashboard */
  .dashph { margin: 0; background: var(--bubble); border-radius: var(--r-l); overflow: hidden; box-shadow: var(--shadow-3); border: 1px solid color-mix(in srgb, var(--green) 14%, transparent); }
  .dashph__bar { display: flex; align-items: center; gap: 7px; padding: 14px 18px; border-bottom: 1px solid color-mix(in srgb, var(--bubble-ink-2) 20%, transparent); }
  .dashph__bar > span { width: 9px; height: 9px; border-radius: 50%; background: color-mix(in srgb, var(--bubble-ink-2) 45%, transparent); }
  .dashph__bar em { margin-left: 10px; font-style: normal; font-size: .72rem; letter-spacing: .05em; text-transform: uppercase; color: var(--bubble-ink-2); display: inline-flex; align-items: center; gap: 8px; }
  .dashph__screen { min-height: 320px; display: grid; place-items: center; padding: 28px;
    background:
      linear-gradient(color-mix(in srgb, var(--green) 5%, transparent) 1px, transparent 1px) 0 0 / 100% 36px,
      linear-gradient(90deg, color-mix(in srgb, var(--green) 5%, transparent) 1px, transparent 1px) 0 0 / 36px 100%; }
  .dashph__note { font-size: .9rem; color: var(--bubble-ink-2); text-align: center; max-width: 24ch; line-height: 1.5;
    border: 1px dashed color-mix(in srgb, var(--bubble-ink-2) 40%, transparent); border-radius: var(--r-m); padding: 18px 22px; }

  @media (max-width: 900px) {
    .out__grid { grid-template-columns: 1fr; gap: 32px; }
  }
</style>
