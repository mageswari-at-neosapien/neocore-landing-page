---
// "Turn visibility into better frontline execution" — management outcomes.
const outcomes = [
  {
    n: 'Measure pitch adherence',
    c: 'Define the messages, questions and steps that matter. NeoCore structures each conversation against those custom fields and shows where execution is consistent or slipping.',
    icon: 'target',
  },
  {
    n: 'Coach with evidence',
    c: 'Identify repeated behaviours and missed steps, then focus coaching on the representatives, teams and regions that need it most.',
    icon: 'coach',
  },
  {
    n: 'Hear the Voice of Customer',
    c: 'Aggregate objections, competitor mentions, product feedback and emerging market themes while they are still actionable.',
    icon: 'voice',
  },
];
const icons: Record<string, string> = {
  target: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="12" r="8.5"/><circle cx="12" cy="12" r="4"/><circle cx="12" cy="12" r="0.8" fill="currentColor" stroke="none"/></svg>',
  coach: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5.5h16v10H9l-4 3v-3H4z"/><path d="M8.8 10.4l2 2 3.6-3.6"/></svg>',
  voice: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M4 12h.01M8 8.5v7M12 5v14M16 9v6M20 11v2"/></svg>',
};
// Live management-dashboard visual (real, de-identified screens — no client name or customer verbatims).
const shots = ['panasonic-1', 'panasonic-4', 'panasonic-3'].map((f) => `/dashboards/panasonic/${f}.webp`);
---

<section id="outcomes" class="fold out glowsec">
  <span class="secglow secglow--tr" aria-hidden="true"></span>
  <div class="shell out__grid">
    <div class="out__copy reveal">
      <h2 class="h2">Turn visibility into <span class="b">better frontline execution.</span></h2>
      <p class="lede">NeoCore makes conversations queryable and comparable, giving leaders the evidence to improve how teams sell and learn.</p>
      <ul class="olist">
        {outcomes.map((o) => (
          <li class="oitem">
            <span class="iconh iconh--sm" aria-hidden="true" set:html={icons[o.icon]} />
            <div>
              <h3 class="oitem__n">{o.n}</h3>
              <p class="oitem__c">{o.c}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>

    <div class="out__view reveal">
      <div class="dashwrap" data-parallax>
        <figure class="dashph" data-depth="0.25">
          <div class="dashph__bar">
            <span></span><span></span><span></span>
            <em><span class="live" aria-hidden="true"></span>Neo Sales Intelligence · live view</em>
          </div>
          <div class="dashph__screen" data-cycle>
            {shots.map((src, i) => <img class:list={["dshot", { 'is-on': i === 0 }]} src={src} alt="NeoCore management dashboard" loading="lazy" decoding="async" width="1600" height="800" />)}
          </div>
        </figure>
        <div class="lift lift--kpi" data-depth="1.4">
          <span class="lift__lbl">Active users · this week</span>
          <span class="lift__big"><b data-count="55">0</b> <i>/ 60</i></span>
          <span class="lift__delta up"><span aria-hidden="true">↗</span> 1.9% vs previous week</span>
        </div>
        <div class="lift lift--voc" data-depth="2.1">
          <span class="lift__lbl">Voice of Customer</span>
          <p class="lift__quote">“Can you match the discount the other store offered?”</p>
          <span class="lift__meta">Pricing objection · flagged in 18 conversations this week</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* section glow */
  .glowsec { position: relative; overflow: hidden; }
  .secglow { position: absolute; width: 720px; height: 620px; border-radius: 50%; pointer-events: none; z-index: 0;
    background: radial-gradient(circle, var(--green-glow), transparent 66%); filter: blur(30px); opacity: .9; }
  .secglow--tr { right: -14%; top: -18%; }
  .glowsec .shell { position: relative; z-index: 1; }

  .iconh { width: 54px; height: 54px; border-radius: 16px; display: grid; place-items: center; color: var(--green-text);
    background: color-mix(in srgb, var(--green) 12%, var(--surface));
    border: 1px solid color-mix(in srgb, var(--green) 26%, transparent);
    box-shadow: 0 14px 30px -14px var(--green-glow), inset 0 1px 0 rgba(255,255,255,.35); }
  .iconh :global(svg) { width: 26px; height: 26px; }

  /* Outcomes — copy + list on the left, management-view visual on the right */
  .out__grid { display: grid; grid-template-columns: 0.92fr 1.08fr; gap: clamp(32px, 5vw, 72px); align-items: center; }
  .out__copy { max-width: 560px; }
  .olist { margin-top: clamp(24px, 3vw, 38px); display: grid; gap: clamp(18px, 2.2vw, 26px); }
  .oitem { display: flex; gap: 16px; align-items: flex-start; }
  .oitem__n { font-size: clamp(1.3rem, 1.7vw, 1.55rem); font-weight: 500; letter-spacing: -0.015em; }
  .oitem__c { margin-top: 5px; color: var(--ink-2); font-size: .95rem; line-height: 1.5; }
  .iconh--sm { width: 46px; height: 46px; border-radius: 13px; flex: none; }
  .iconh--sm :global(svg) { width: 22px; height: 22px; }

  /* right-hand visual — live management dashboard with floating UI layers */
  .dashwrap { position: relative; padding: 30px 22px 44px; }
  .dashph { margin: 0; position: relative; z-index: 1; background: var(--bubble); border-radius: var(--r-l); overflow: hidden; box-shadow: 0 44px 84px -46px rgba(0,0,0,.5); border: 1px solid color-mix(in srgb, var(--green) 14%, transparent); transition: transform .3s ease; will-change: transform; }
  .dashph__bar { display: flex; align-items: center; gap: 7px; padding: 13px 18px; border-bottom: 1px solid color-mix(in srgb, var(--bubble-ink-2) 20%, transparent); }
  .dashph__bar > span { width: 9px; height: 9px; border-radius: 50%; background: color-mix(in srgb, var(--bubble-ink-2) 45%, transparent); }
  .dashph__bar em { margin-left: 10px; font-style: normal; font-size: .72rem; letter-spacing: .05em; text-transform: uppercase; color: var(--bubble-ink-2); display: inline-flex; align-items: center; gap: 8px; }
  .live { width: 8px; height: 8px; border-radius: 50%; background: var(--green); animation: livePulse 2s infinite; }
  @keyframes livePulse { 0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--green) 60%, transparent); } 70% { box-shadow: 0 0 0 7px transparent; } 100% { box-shadow: 0 0 0 0 transparent; } }

  .dashph__screen { position: relative; aspect-ratio: 2 / 1; overflow: hidden; background: #0e1512; }
  .dshot { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: top center; opacity: 0; transition: opacity 1.1s ease; }
  .dshot.is-on { opacity: 1; }

  /* floating live cards */
  .lift { position: absolute; z-index: 3; background: var(--surface); border: 1px solid var(--hair); border-radius: 16px; padding: 15px 17px;
    box-shadow: 0 26px 50px -22px rgba(0,0,0,.35); transition: transform .3s ease; will-change: transform; }
  .lift__lbl { display: block; font-size: .6rem; letter-spacing: .07em; text-transform: uppercase; font-weight: 700; color: var(--ink-3); margin-bottom: 7px; }
  .lift--kpi { top: 12px; right: 2px; width: 196px; }
  .lift__big { font-size: 1.9rem; font-weight: 500; letter-spacing: -.03em; color: var(--ink); line-height: 1; }
  .lift__big i { font-style: normal; font-size: 1rem; color: var(--ink-3); }
  .lift__delta { display: block; margin-top: 7px; font-size: .76rem; font-weight: 600; }
  .lift__delta.up { color: var(--green-text); }
  .lift--voc { bottom: 18px; left: 0; width: 256px; }
  .lift__quote { font-size: .92rem; line-height: 1.4; color: var(--ink); margin: 0; }
  .lift__meta { display: block; margin-top: 9px; font-size: .72rem; color: var(--ink-3); }

  @media (max-width: 900px) {
    .out__grid { grid-template-columns: 1fr; gap: 32px; }
  }
  @media (max-width: 560px) {
    .dashwrap { padding: 18px 8px 26px; }
    .lift { padding: 10px 12px; border-radius: 13px; transform: none !important; }
    .lift__lbl { font-size: .56rem; margin-bottom: 5px; }
    .lift--kpi { top: 6px; right: 0; width: 122px; }
    .lift--kpi .lift__big { font-size: 1.35rem; }
    .lift--kpi .lift__big i { font-size: .82rem; }
    .lift--kpi .lift__delta { font-size: .66rem; margin-top: 5px; }
    .lift--voc { bottom: 6px; left: 0; width: 176px; }
    .lift--voc .lift__quote { font-size: .76rem; line-height: 1.35; }
    .lift--voc .lift__meta { font-size: .64rem; margin-top: 7px; }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('#outcomes');
  if (root) {
    // crossfade the dashboard screens
    const screen = root.querySelector<HTMLElement>('[data-cycle]');
    if (screen) {
      const shots = Array.from(screen.querySelectorAll<HTMLImageElement>('.dshot'));
      if (shots.length > 1) { let i = 0; setInterval(() => { i = (i + 1) % shots.length; shots.forEach((s, k) => s.classList.toggle('is-on', k === i)); }, 4600); }
    }
    // count the KPI up when it scrolls into view
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        (e.target as HTMLElement).querySelectorAll<HTMLElement>('[data-count]').forEach((el) => {
          const target = Number(el.getAttribute('data-count') || '0'); const start = performance.now();
          const tick = (now: number) => { const p = Math.min(1, (now - start) / 1200); el.textContent = String(Math.round(target * (1 - Math.pow(1 - p, 3)))); if (p < 1) requestAnimationFrame(tick); };
          requestAnimationFrame(tick);
        });
        io.unobserve(e.target);
      });
    }, { threshold: 0.5 });
    const wrap = root.querySelector('.dashwrap');
    if (wrap) io.observe(wrap);
    // cursor parallax on the floating layers
    const stage = root.querySelector<HTMLElement>('[data-parallax]');
    if (stage && window.matchMedia('(prefers-reduced-motion: no-preference)').matches && window.matchMedia('(min-width: 561px)').matches) {
      const layers = Array.from(stage.querySelectorAll<HTMLElement>('[data-depth]'));
      stage.addEventListener('mousemove', (ev) => {
        const r = stage.getBoundingClientRect();
        const dx = (ev.clientX - r.left) / r.width - 0.5;
        const dy = (ev.clientY - r.top) / r.height - 0.5;
        layers.forEach((l) => { const d = Number(l.getAttribute('data-depth') || '1'); l.style.transform = `translate(${dx * d * 14}px, ${dy * d * 14}px)`; });
      });
      stage.addEventListener('mouseleave', () => layers.forEach((l) => { l.style.transform = 'translate(0,0)'; }));
    }
  }
</script>
