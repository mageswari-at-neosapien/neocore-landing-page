---
// Fold 4 — Management outcomes, enterprise capabilities, ungated sample.
// Premium redesign: glowing icon holders, depth, product-grade sample.
const outcomes = [
  {
    n: 'Measure pitch adherence',
    c: 'Define the messages, questions and steps that matter. NeoCore structures each conversation against those custom fields and shows where execution is consistent or slipping.',
    icon: 'target',
    tags: [{ t: 'Scheme comparison', v: 'Covered', ok: true }, { t: 'Margin objection', v: 'Missed', miss: true }],
  },
  {
    n: 'Coach with evidence',
    c: 'Identify repeated behaviours and missed steps, then focus coaching on the representatives, teams and regions that need it most.',
    icon: 'coach',
    tags: [{ t: 'Margin objection', v: 'West · 34 reps', rank: '01' }, { t: 'Scheme step', v: 'South · 21 reps', rank: '02' }],
  },
  {
    n: 'Hear the Voice of Customer',
    c: 'Aggregate objections, competitor mentions, product feedback and emerging market themes while they are still actionable.',
    icon: 'voice',
    voc: ['Competitor margin', 'Scheme clarity', 'Stock availability', 'Price sensitivity'],
  },
];
const caps = [
  { n: 'Breakthrough technology', c: 'Multilingual processing, speaker attribution, emotion capture and processing in under two minutes.', icon: 'spark' },
  { n: 'Tailored to your needs', c: 'Tune NeoCore for local brands, products, competitors, industry terminology and regional sales language.', icon: 'tune' },
  { n: 'Built for adoption', c: 'Friction-light capture minimizes additional administrative work for frontline teams.', icon: 'adopt' },
  { n: 'API-first', c: 'Connect NeoCore intelligence with CRM, BI and enterprise workflows through APIs and MCP.', icon: 'api' },
];
const structured = [
  { k: 'Pitch adherence', v: '4 of 5 required points covered' },
  { k: 'Missed topic', v: 'Current retailer scheme', miss: true },
  { k: 'Coaching priority', v: 'Address the margin objection using the approved comparison' },
  { k: 'Voice of Customer', v: 'Competitor margin pressure' },
  { k: 'Next action', v: 'Follow up with the updated scheme' },
];
// A deterministic, speech-like waveform profile (varied bar heights + ripple delays).
const wave = Array.from({ length: 72 }, (_, i) => {
  const v = Math.abs(Math.sin(i * 0.7) * 0.5 + Math.sin(i * 1.9 + 1) * 0.3 + Math.sin(i * 0.33) * 0.2);
  return { h: Math.round(14 + v * 86), d: +((i % 16) * 0.05).toFixed(2) };
});
const icons: Record<string, string> = {
  target: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="12" r="8.5"/><circle cx="12" cy="12" r="4"/><circle cx="12" cy="12" r="0.8" fill="currentColor" stroke="none"/></svg>',
  coach: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5.5h16v10H9l-4 3v-3H4z"/><path d="M8.8 10.4l2 2 3.6-3.6"/></svg>',
  voice: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M4 12h.01M8 8.5v7M12 5v14M16 9v6M20 11v2"/></svg>',
  spark: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"><path d="M12 3c.7 4.6 2 5.9 6.5 6.5C14 10.1 12.7 11.4 12 16c-.7-4.6-2-5.9-6.5-6.5C10 8.9 11.3 7.6 12 3z"/></svg>',
  tune: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M3 7h5M12 7h9M3 12h13M20 12h1M3 17h8M15 17h6"/><circle cx="10" cy="7" r="2"/><circle cx="18" cy="12" r="2"/><circle cx="13" cy="17" r="2"/></svg>',
  adopt: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3"/><path d="M3.5 19c0-3 2.5-5.2 5.5-5.2S14.5 16 14.5 19"/><path d="M15.8 5.6a3 3 0 0 1 0 5.6M17.4 13.9c2.2.6 3.8 2.5 3.8 4.9"/></svg>',
  api: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M8.5 7.5 4.5 12l4 4.5M15.5 7.5l4 4.5-4 4.5M13.5 5l-3 14"/></svg>',
};
---

<section id="outcomes" class="fold out glowsec">
  <span class="secglow secglow--tr" aria-hidden="true"></span>
  <div class="shell out__grid">
    <div class="out__copy reveal">
      <h2 class="h2">Turn visibility into <span class="b">better frontline execution.</span></h2>
      <p class="lede">NeoCore makes conversations queryable and comparable, giving leaders the evidence to improve how teams sell and learn.</p>
      <ul class="olist">
        {outcomes.map((o, i) => (
          <li class="oitem" class:list={[{ 'oitem--lg': i < 2 }]}>
            <span class="iconh iconh--sm" aria-hidden="true" set:html={icons[o.icon]} />
            <div>
              <h3 class="oitem__n">{o.n}</h3>
              <p class="oitem__c">{o.c}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>

    <div class="out__view reveal">
      <div class="mgmt">
        <div class="mgmt__cap"><span class="live" aria-hidden="true"></span>NeoCore · Management view<span class="tag mgmt__tagr">Illustrative view</span></div>
        <div class="mgmt__metric">
          <span class="mgmt__big">84%</span>
          <span class="mgmt__ml">Team pitch adherence<em>On target · +6 pts this quarter</em></span>
        </div>
        <div class="mgmt__block">
          <span class="mgmt__lbl">Coaching priorities</span>
          <div class="mgmt__row"><span class="mgmt__rk">01</span> Margin objection <em>West · 34 reps</em></div>
          <div class="mgmt__row"><span class="mgmt__rk">02</span> Scheme comparison step <em>South · 21 reps</em></div>
        </div>
        <div class="mgmt__block">
          <span class="mgmt__lbl">Voice of Customer · rising</span>
          <div class="mgmt__tags">
            <span class="mt mt--up">Competitor margin ↗</span>
            <span class="mt">Scheme clarity</span>
            <span class="mt">Stock availability</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="fold capsfold glowsec">
  <span class="secglow secglow--bl" aria-hidden="true"></span>
  <div class="shell caps__grid">
    <div class="caps__copy reveal">
      <h2 class="h2">Built for <span class="b">enterprise scale.</span></h2>
      <p class="lede">The breakthrough technology, tuning, adoption and integrations enterprise deployment needs.</p>
      <ul class="crail" data-crail role="tablist" aria-label="Enterprise capabilities">
        {caps.map((c, i) => (
          <li class="crow" class:list={[{ 'is-active': i === 0 }]} data-crow={i} role="tab" tabindex="0" aria-selected={i === 0 ? 'true' : 'false'}>
            <span class="iconh iconh--sm" aria-hidden="true" set:html={icons[c.icon]} />
            <div class="crow__body">
              <h3 class="crow__n">{c.n}<span class="crow__num">{String(i + 1).padStart(2, '0')}</span></h3>
              <p class="crow__c">{c.c}</p>
            </div>
            <span class="crow__bar" aria-hidden="true"><i></i></span>
          </li>
        ))}
      </ul>
    </div>

    <div class="caps__view reveal">
      <div class="capscreen" data-capscreen>
        <div class="capscreen__body">
          <!-- 0 · Breakthrough technology -->
          <div class="capstate is-active" data-capstate="0">
            <div class="cs__cap"><span class="live" aria-hidden="true"></span>Processing · Neo One</div>
            <div class="cs__wave" aria-hidden="true">{wave.map((b) => <span style={`--h:${b.h}%;--d:${b.d}s`}></span>)}</div>
            <div class="cs__chips">
              <span class="cchip">Hindi</span><span class="cchip">Tamil</span><span class="cchip">English</span><span class="cchip">Telugu</span><span class="cchip cchip--muted">+96 languages</span>
            </div>
            <div class="cs__meta">
              <span class="cpill">Speaker · Rep</span><span class="cpill">Speaker · Retailer</span><span class="cpill cpill--g">Tone · Confident</span>
            </div>
            <div class="cs__timer">
              <div class="cs__tbar"><i></i></div>
              <span class="cs__tlbl">01:48 · processed in under two minutes</span>
            </div>
          </div>

          <!-- 1 · Tailored to your needs -->
          <div class="capstate" data-capstate="1">
            <div class="cs__cap">Tuning profile · West region</div>
            <ul class="cs__tune">
              <li><span class="cs__tk">Brands</span><span class="cs__tv">NeoGold · SunMax · +12</span><span class="cs__ok" aria-hidden="true">✓</span></li>
              <li><span class="cs__tk">Competitors</span><span class="cs__tv">Brand X · Brand Y</span><span class="cs__ok" aria-hidden="true">✓</span></li>
              <li><span class="cs__tk">Terminology</span><span class="cs__tv">Scheme · margin · beat</span><span class="cs__ok" aria-hidden="true">✓</span></li>
              <li><span class="cs__tk">Regional language</span><span class="cs__tv">Code-mixed Hinglish</span><span class="cs__ok" aria-hidden="true">✓</span></li>
            </ul>
          </div>

          <!-- 2 · Built for adoption -->
          <div class="capstate" data-capstate="2">
            <div class="cs__cap">Frontline capture</div>
            <div class="cs__tap">
              <span class="cs__mic" aria-hidden="true"><span></span></span>
              <div><b>One tap to capture</b><em>No forms. No manual logging.</em></div>
            </div>
            <div class="cs__compare">
              <span class="cs__clbl">Instead of</span>
              <ul class="cs__old"><li>Log the call</li><li>Fill the CRM form</li><li>Tag and submit</li></ul>
              <span class="cs__cgo" aria-hidden="true">→</span>
              <span class="cs__cnew">Tap once. Keep selling.</span>
            </div>
          </div>

          <!-- 3 · API-first -->
          <div class="capstate" data-capstate="3">
            <div class="cs__cap">Integrations</div>
            <div class="cs__hub">
              <span class="cs__core">NeoCore</span>
              <ul class="cs__nodes">
                <li class="cs__node"><span class="cs__line" aria-hidden="true"></span>CRM<em>Synced</em></li>
                <li class="cs__node"><span class="cs__line" aria-hidden="true"></span>BI dashboards<em>Synced</em></li>
                <li class="cs__node"><span class="cs__line" aria-hidden="true"></span>MCP<em>Live</em></li>
                <li class="cs__node"><span class="cs__line" aria-hidden="true"></span>Webhooks<em>Active</em></li>
              </ul>
            </div>
            <code class="cs__json">GET /v1/conversations/<span class="cs__jk">:id</span>/insights</code>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section id="sample-analysis" class="fold samplefold glowsec">
  <span class="secglow secglow--tr" aria-hidden="true"></span>
  <div class="shell">
    <div class="sample reveal" data-evt-view="sample_analysis_view">
      <div class="sample__head">
        <div>
          <h2 class="h2 sample__h">See what NeoCore <span class="b">produces.</span></h2>
          <p class="sample__desc">One frontline conversation, scanned and turned into structured intelligence: pitch adherence, coaching priorities and the Voice of Customer, ready to act on.</p>
        </div>
        <button type="button" class="ghost sample__demo" data-lead-open data-evt="tailored_demo_click" data-evt-source="sample">See a tailored demo</button>
      </div>

      <div class="analysis">
        <div class="analysis__in" data-convo>
          <span class="scanbeam" aria-hidden="true"></span>
          <span class="analysis__cap"><span class="live" aria-hidden="true"></span>One conversation</span>
          <p class="analysis__quote">“Brand X offers us a better margin. I can stock this product if your scheme improves.”</p>
          <span class="analysis__who">Retailer · West region · Neo One</span>
        </div>
        <div class="analysis__flow" aria-hidden="true"><span></span><span></span><span></span></div>
        <div class="analysis__out" data-analysis>
          {structured.map((s) => (
            <div class="afield" class:list={[{ 'afield--miss': s.miss }]}>
              <span class="afield__node" aria-hidden="true"></span>
              <span class="afield__k">{s.k}</span>
              <span class="afield__v">{s.v}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* section glow */
  .glowsec { position: relative; overflow: hidden; }
  .secglow { position: absolute; width: 720px; height: 620px; border-radius: 50%; pointer-events: none; z-index: 0;
    background: radial-gradient(circle, var(--green-glow), transparent 66%); filter: blur(30px); opacity: .9; }
  .secglow--tr { right: -14%; top: -18%; }
  .secglow--bl { left: -16%; bottom: -22%; }
  .glowsec .shell { position: relative; z-index: 1; }

  .iconh { width: 54px; height: 54px; border-radius: 16px; display: grid; place-items: center; color: var(--green-text);
    background: color-mix(in srgb, var(--green) 12%, var(--surface));
    border: 1px solid color-mix(in srgb, var(--green) 26%, transparent);
    box-shadow: 0 14px 30px -14px var(--green-glow), inset 0 1px 0 rgba(255,255,255,.35); }
  .iconh :global(svg) { width: 26px; height: 26px; }

  /* Outcomes — copy + list on the left, management-view visual on the right */
  .out__grid { display: grid; grid-template-columns: 0.92fr 1.08fr; gap: clamp(32px, 5vw, 72px); align-items: center; }
  .out__copy { max-width: 560px; }
  .olist { margin-top: clamp(24px, 3vw, 38px); display: grid; gap: clamp(18px, 2.2vw, 26px); }
  .oitem { display: flex; gap: 16px; align-items: flex-start; }
  .oitem__n { font-size: 1.15rem; font-weight: 500; letter-spacing: -0.015em; }
  .oitem--lg .oitem__n { font-size: clamp(1.3rem, 1.7vw, 1.55rem); }
  .oitem__c { margin-top: 5px; color: var(--ink-2); font-size: .95rem; line-height: 1.5; }
  .oitem:not(.oitem--lg) .oitem__c { font-size: .9rem; }
  .iconh--sm { width: 46px; height: 46px; border-radius: 13px; flex: none; }
  .iconh--sm :global(svg) { width: 22px; height: 22px; }
  .oitem:not(.oitem--lg) .iconh--sm { width: 40px; height: 40px; }

  /* management-view product visual (a real "screen", dark in both themes) */
  .mgmt { position: relative; background: var(--bubble); border-radius: var(--r-l); padding: clamp(24px, 2.4vw, 32px); color: var(--bubble-ink); box-shadow: var(--shadow-3); border: 1px solid color-mix(in srgb, var(--green) 14%, transparent); }
  .mgmt::before { content: ""; position: absolute; inset: 0 0 auto 0; height: 1px; border-radius: var(--r-l) var(--r-l) 0 0; background: linear-gradient(90deg, transparent, rgba(0,223,121,.4), transparent); }
  .mgmt__cap { display: flex; align-items: center; gap: 9px; font-size: .72rem; letter-spacing: .08em; text-transform: uppercase; color: var(--bubble-ink-2); margin-bottom: 22px; }
  .mgmt__tagr { margin-left: auto; color: var(--bubble-ink-2); }
  .mgmt__metric { display: flex; align-items: baseline; gap: 18px; padding-bottom: 22px; margin-bottom: 20px; border-bottom: 1px solid var(--inset-line); }
  .mgmt__big { font-size: clamp(2.8rem, 4vw, 3.6rem); font-weight: 600; color: var(--green); letter-spacing: -0.03em; line-height: .9; }
  .mgmt__ml { color: var(--bubble-ink); font-size: 1rem; font-weight: 500; }
  .mgmt__ml em { display: block; font-style: normal; color: var(--bubble-ink-2); font-size: .82rem; margin-top: 5px; font-weight: 400; }
  .mgmt__block { margin-top: 18px; }
  .mgmt__lbl { display: block; font-size: .66rem; letter-spacing: .06em; text-transform: uppercase; color: var(--bubble-ink-2); margin-bottom: 12px; }
  .mgmt__row { display: flex; align-items: center; gap: 12px; padding: 6px 0; font-size: .96rem; color: var(--bubble-ink); }
  .mgmt__rk { width: 24px; height: 24px; border-radius: 50%; background: rgba(0,223,121,.16); color: var(--green); display: grid; place-items: center; font-size: .66rem; font-weight: 700; flex: none; }
  .mgmt__row em { margin-left: auto; font-style: normal; color: var(--bubble-ink-2); font-size: .82rem; }
  .mgmt__tags { display: flex; flex-wrap: wrap; gap: 8px; }
  .mt { background: var(--inset-2); border: 1px solid var(--inset-line); border-radius: var(--r-pill); padding: 8px 14px; font-size: .86rem; color: var(--bubble-ink); }
  .mt--up { background: var(--green); color: var(--green-ink); border-color: transparent; font-weight: 500; }

  /* Capabilities — left rail auto-advances, right screen morphs per capability */
  .caps__grid { display: grid; grid-template-columns: 0.96fr 1.04fr; gap: clamp(32px, 5vw, 72px); align-items: center; }
  .caps__copy { max-width: 560px; }
  .crail { list-style: none; margin-top: clamp(24px, 3vw, 36px); display: grid; gap: 6px; }
  .crow { position: relative; display: flex; gap: 15px; align-items: flex-start; padding: 15px 16px; border-radius: var(--r-m);
    border: 1px solid transparent; cursor: pointer; transition: background .25s var(--ease), border-color .25s var(--ease), opacity .25s var(--ease); }
  .crow:not(.is-active) { opacity: .58; }
  .crow:not(.is-active):hover { opacity: .85; background: color-mix(in srgb, var(--green) 5%, transparent); }
  .crow.is-active { background: linear-gradient(120deg, color-mix(in srgb, var(--green) 9%, var(--surface)), var(--surface) 78%);
    border-color: color-mix(in srgb, var(--green) 22%, var(--hair)); box-shadow: var(--shadow-1); }
  .crow:focus-visible { outline: 2px solid var(--green); outline-offset: 2px; }
  .crow .iconh--sm { width: 42px; height: 42px; flex: none; transition: transform .25s var(--ease); }
  .crow.is-active .iconh--sm { transform: scale(1.04); }
  .crow__body { flex: 1; min-width: 0; }
  .crow__n { font-size: 1.12rem; font-weight: 500; letter-spacing: -0.015em; display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
  .crow__num { font-size: .72rem; font-weight: 600; color: var(--ink-3); font-variant-numeric: tabular-nums; }
  .crow__c { margin-top: 4px; color: var(--ink-2); font-size: .9rem; line-height: 1.45; }
  .crow__bar { display: block; height: 2px; margin-top: 12px; border-radius: 2px; background: var(--hair); overflow: hidden; opacity: 0; }
  .crow.is-active .crow__bar { opacity: 1; }
  .crow__bar i { display: block; height: 100%; width: 0; background: var(--green); border-radius: 2px; }
  .crow.is-active .crow__bar i { animation: crbar var(--cdwell, 3.8s) linear forwards; }
  @keyframes crbar { to { width: 100%; } }

  /* the morphing product screen (dark in both themes) */
  .capscreen { position: relative; background: var(--bubble); border-radius: var(--r-l); padding: clamp(22px, 2.4vw, 30px);
    color: var(--bubble-ink); box-shadow: var(--shadow-3); border: 1px solid color-mix(in srgb, var(--green) 14%, transparent); }
  .capscreen::before { content: ""; position: absolute; inset: 0 0 auto 0; height: 1px; border-radius: var(--r-l) var(--r-l) 0 0; background: linear-gradient(90deg, transparent, rgba(0,223,121,.4), transparent); }
  .capscreen__body { position: relative; min-height: 300px; }
  .capstate { position: absolute; inset: 0; display: flex; flex-direction: column; opacity: 0; visibility: hidden; transition: opacity .4s var(--ease); }
  .capstate.is-active { opacity: 1; visibility: visible; }
  .cs__cap { display: inline-flex; align-items: center; gap: 9px; font-size: .72rem; letter-spacing: .08em; text-transform: uppercase; color: var(--bubble-ink-2); margin-bottom: 20px; }
  /* inner elements rise in when the state activates */
  .capstate.is-active > :not(.cs__cap) { animation: csRise .5s var(--ease) both; }
  .capstate.is-active > :nth-child(3) { animation-delay: .06s; }
  .capstate.is-active > :nth-child(4) { animation-delay: .12s; }
  .capstate.is-active > :nth-child(5) { animation-delay: .18s; }
  @keyframes csRise { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }

  /* state 0 — processing */
  .cs__wave { display: flex; align-items: center; justify-content: space-between; gap: 0; height: 56px; margin-bottom: 20px; }
  .cs__wave span { flex: none; width: 2px; height: var(--h, 50%); border-radius: 2px; transform: scaleY(.5); transform-origin: center;
    background: var(--green); opacity: .9; }
  .capstate.is-active .cs__wave span {
    animation-name: cswave; animation-duration: 1.15s; animation-timing-function: cubic-bezier(.4,0,.5,1);
    animation-iteration-count: infinite; animation-direction: alternate; animation-delay: var(--d, 0s); }
  @keyframes cswave { from { transform: scaleY(.32); opacity: .65; } to { transform: scaleY(1); opacity: 1; } }
  .cs__chips { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 16px; }
  .cchip { font-size: .84rem; padding: 6px 13px; border-radius: var(--r-pill); background: var(--inset-2); border: 1px solid var(--inset-line); color: var(--bubble-ink); }
  .cchip--muted { color: var(--bubble-ink-2); }
  .cs__meta { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: auto; }
  .cpill { font-size: .8rem; padding: 6px 12px; border-radius: var(--r-pill); background: var(--inset); color: var(--bubble-ink-2); }
  .cpill--g { background: var(--green); color: var(--green-ink); font-weight: 500; }
  .cs__timer { margin-top: 20px; }
  .cs__tbar { height: 6px; border-radius: 6px; background: var(--inset-line); overflow: hidden; }
  .cs__tbar i { display: block; height: 100%; width: 82%; border-radius: 6px; background: var(--green); }
  .capstate.is-active .cs__tbar i { animation: cstimer 1.6s var(--ease) both; }
  @keyframes cstimer { from { width: 0; } to { width: 82%; } }
  .cs__tlbl { display: block; margin-top: 10px; font-size: .82rem; color: var(--bubble-ink-2); }

  /* state 1 — tuning */
  .cs__tune { list-style: none; display: grid; gap: 10px; margin: auto 0; }
  .cs__tune li { display: flex; align-items: center; gap: 12px; padding: 13px 16px; border-radius: var(--r-m); background: var(--inset); border: 1px solid var(--inset-line); }
  .cs__tk { font-size: .96rem; color: var(--bubble-ink); font-weight: 500; width: 42%; }
  .cs__tv { font-size: .88rem; color: var(--bubble-ink-2); flex: 1; }
  .cs__ok { width: 22px; height: 22px; border-radius: 50%; background: var(--green); color: var(--green-ink); display: grid; place-items: center; font-size: .64rem; font-weight: 800; flex: none; }

  /* state 2 — adoption */
  .cs__tap { display: flex; align-items: center; gap: 16px; padding: 16px; border-radius: var(--r-m); background: var(--inset); border: 1px solid var(--inset-line); margin-bottom: 18px; }
  .cs__mic { width: 46px; height: 46px; border-radius: 50%; background: var(--green); display: grid; place-items: center; flex: none; position: relative; }
  .cs__mic span { width: 15px; height: 15px; border-radius: 50%; background: var(--green-ink); }
  .capstate.is-active .cs__mic::after { content: ""; position: absolute; inset: 0; border-radius: 50%; border: 2px solid var(--green); animation: csping 1.8s ease-out infinite; }
  @keyframes csping { 0% { transform: scale(1); opacity: .7; } 100% { transform: scale(1.7); opacity: 0; } }
  .cs__tap b { font-size: 1.08rem; font-weight: 500; color: var(--bubble-ink); }
  .cs__tap em { display: block; font-style: normal; color: var(--bubble-ink-2); font-size: .86rem; margin-top: 3px; }
  .cs__compare { display: flex; align-items: center; flex-wrap: wrap; gap: 12px; margin-top: auto; }
  .cs__clbl { font-size: .68rem; letter-spacing: .06em; text-transform: uppercase; color: var(--bubble-ink-2); width: 100%; }
  .cs__old { list-style: none; display: flex; flex-wrap: wrap; gap: 8px; }
  .cs__old li { font-size: .82rem; color: var(--bubble-ink-2); padding: 5px 11px; border-radius: var(--r-pill); background: var(--inset-2); text-decoration: line-through; text-decoration-color: color-mix(in srgb, var(--bubble-ink-2) 60%, transparent); }
  .cs__cgo { color: var(--green); font-size: 1.1rem; }
  .cs__cnew { font-size: .9rem; font-weight: 500; color: var(--green); padding: 6px 13px; border-radius: var(--r-pill); background: var(--green-glow); }

  /* state 3 — integrations */
  .cs__hub { display: flex; align-items: center; gap: 20px; margin: auto 0; }
  .cs__core { flex: none; font-size: 1rem; font-weight: 600; color: var(--green-ink); background: var(--green); padding: 14px 20px; border-radius: 14px; box-shadow: 0 10px 26px -10px var(--green-glow); }
  .cs__nodes { list-style: none; flex: 1; display: grid; gap: 8px; }
  .cs__node { position: relative; display: flex; align-items: center; gap: 12px; padding: 11px 15px 11px 22px; font-size: .94rem; color: var(--bubble-ink);
    background: var(--inset); border: 1px solid var(--inset-line); border-radius: var(--r-m); }
  .cs__node em { margin-left: auto; font-style: normal; font-size: .74rem; color: var(--green); display: inline-flex; align-items: center; gap: 6px; }
  .cs__node em::before { content: ""; width: 7px; height: 7px; border-radius: 50%; background: var(--green); box-shadow: 0 0 0 3px var(--green-glow); }
  .cs__line { position: absolute; left: -20px; top: 50%; width: 20px; height: 1px; background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--green) 55%, transparent)); }
  .capstate.is-active .cs__node { animation: csnode .5s var(--ease) both; }
  .capstate.is-active .cs__node:nth-child(2) { animation-delay: .08s; }
  .capstate.is-active .cs__node:nth-child(3) { animation-delay: .16s; }
  .capstate.is-active .cs__node:nth-child(4) { animation-delay: .24s; }
  @keyframes csnode { from { opacity: 0; transform: translateX(8px); } to { opacity: 1; transform: none; } }
  .cs__json { display: block; margin-top: 20px; font-family: ui-monospace, "SF Mono", Menlo, monospace; font-size: .82rem; color: var(--bubble-ink-2);
    background: var(--inset); border: 1px solid var(--inset-line); border-radius: var(--r-s, 10px); padding: 12px 15px; overflow-x: auto; }
  .cs__jk { color: var(--green); }

  /* Sample — product-grade */
  .sample__head { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; flex-wrap: wrap; margin-bottom: clamp(24px, 3vw, 40px); }
  .sample__h { margin-top: 0; }
  .sample__desc { margin-top: 16px; max-width: 52ch; color: var(--ink-2); font-size: clamp(1.02rem, 1.15vw, 1.15rem); line-height: 1.5; }
  .analysis { display: grid; grid-template-columns: 1fr auto 1.15fr; align-items: center; gap: clamp(16px, 2vw, 32px); }
  .analysis__in { background: var(--bubble); border-radius: 24px 24px 8px 24px; padding: 28px; color: var(--bubble-ink); box-shadow: var(--shadow-3); position: relative; }
  .analysis__in::after { content: ""; position: absolute; inset: 0; border-radius: inherit; box-shadow: inset 0 1px 0 rgba(255,255,255,.06); pointer-events: none; }
  .analysis__cap { font-size: .72rem; letter-spacing: .08em; text-transform: uppercase; color: var(--bubble-ink-2); display: inline-flex; align-items: center; gap: 8px; }
  .analysis__quote { margin-top: 16px; font-size: 1.32rem; line-height: 1.4; color: var(--bubble-ink); }
  .analysis__who { margin-top: 16px; display: block; color: var(--bubble-ink-2); font-size: .84rem; }
  .analysis__flow { display: flex; flex-direction: column; gap: 6px; align-items: center; }
  .analysis__flow span { width: 34px; height: 3px; border-radius: 3px; background: linear-gradient(90deg, var(--green-dim, var(--green)), var(--green)); opacity: .85; }
  .analysis__flow span:nth-child(2) { width: 24px; opacity: .55; }
  .analysis__flow span:nth-child(3) { width: 30px; opacity: .7; }
  /* scan the conversation, then print the results point by point */
  .analysis__in { overflow: hidden; }
  .scanbeam { position: absolute; left: 0; right: 0; top: -52px; height: 52px; pointer-events: none; opacity: 0; z-index: 3; border-radius: 4px;
    background: linear-gradient(180deg, rgba(0,223,121,0), rgba(0,223,121,.10) 62%, rgba(0,223,121,.22));
    border-bottom: 2px solid rgba(0,223,121,.9); box-shadow: 0 12px 26px -6px var(--green-glow); }
  .is-scanning .scanbeam { animation: scanUpDown 4s ease-in-out; }
  @keyframes scanUpDown {
    0%   { top: -52px; opacity: 0; }
    8%   { opacity: 1; }
    46%  { top: 100%; opacity: 1; }
    54%  { top: 100%; opacity: 1; }
    92%  { top: -52px; opacity: 1; }
    100% { top: -52px; opacity: 0; }
  }

  .analysis__out { position: relative; display: grid; gap: 4px; }
  .afield { position: relative; display: grid; gap: 4px; padding: 14px 0 14px 28px; }
  .afield__node { position: absolute; left: 0; top: 20px; width: 12px; height: 12px; border-radius: 50%;
    background: var(--green); box-shadow: 0 0 0 4px var(--ground); transition: background .35s var(--ease), box-shadow .35s var(--ease); }
  .afield--miss .afield__node { background: #e0a13a; }
  .afield__k { font-size: .72rem; letter-spacing: .05em; text-transform: uppercase; color: var(--ink-3); }
  .afield__v { font-size: 1.05rem; color: var(--ink); }
  .afield--miss .afield__v { color: #c88a1e; }

  /* armed by JS: nodes idle, results hidden until a thread derives them */
  .is-armed .afield__node { background: var(--inset-line); box-shadow: 0 0 0 4px var(--ground); }
  .is-armed .afield.is-done .afield__node { background: var(--green); box-shadow: 0 0 0 4px var(--ground), 0 0 12px 2px var(--green-glow); }
  .is-armed .afield--miss.is-done .afield__node { background: #e0a13a; box-shadow: 0 0 0 4px var(--ground), 0 0 12px 2px rgba(224,161,58,.55); }
  .is-armed .afield__k, .is-armed .afield__v { opacity: 0; }
  .is-armed .afield.is-done .afield__k { animation: fieldReveal .5s var(--ease) forwards; }
  .is-armed .afield.is-done .afield__v { animation: fieldReveal .55s var(--ease) .1s forwards; }
  @keyframes fieldReveal { from { opacity: 0; clip-path: inset(0 100% 0 0); transform: translateY(2px); } to { opacity: 1; clip-path: inset(0 0 0 0); transform: none; } }

  @media (max-width: 900px) {
    .out__grid { grid-template-columns: 1fr; gap: 32px; }
    .caps__grid { grid-template-columns: 1fr; gap: 32px; }
    .analysis { grid-template-columns: 1fr; }
    .analysis__flow { flex-direction: row; margin: 4px 0; }
    .analysis__in { border-radius: 22px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .crow.is-active .crow__bar i, .capstate.is-active .cs__wave span,
    .capstate.is-active .cs__tbar i, .capstate.is-active .cs__mic::after { animation: none; }
    .capstate.is-active > :not(.cs__cap), .capstate.is-active .cs__node { animation: none; }
  }
</style>

<script>
  // Sample analysis — scan the conversation, then print the results point by point.
  const el = document.querySelector<HTMLElement>('[data-analysis]');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (el && !reduced) {
    const analysis = el.closest<HTMLElement>('.analysis')!;
    const convo = analysis.querySelector<HTMLElement>('[data-convo]')!;
    const fields = Array.from(el.querySelectorAll<HTMLElement>('.afield'));
    const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));
    el.classList.add('is-armed');
    let visible = false, looping = false;

    const pass = async () => {
      // reset
      fields.forEach((f) => f.classList.remove('is-done'));
      convo.classList.remove('is-scanning');
      void convo.offsetWidth; // restart the scan animation cleanly
      await wait(350);
      // 1) scan the conversation — slower, sweeping down and back up (4s)
      convo.classList.add('is-scanning');
      // 2) once the beam reaches the bottom (~45% of the 4s scan), start listing the
      //    points — the beam keeps sweeping back up while they print.
      await wait(1850);
      for (let i = 0; i < fields.length && visible; i++) {
        fields[i].classList.add('is-done');
        await wait(520);
      }
      await wait(5000); // keep all points listed for ~5s
    };

    const loop = async () => {
      if (looping) return; looping = true;
      while (visible) {
        await pass();
        if (!visible) break;
        el.style.transition = 'opacity .45s'; el.style.opacity = '0';
        await wait(470);
        el.style.opacity = ''; el.style.transition = '';
        await wait(160);
      }
      looping = false;
    };

    const io = new IntersectionObserver(
      (entries) => entries.forEach((e) => { visible = e.isIntersecting; if (visible) loop(); }),
      { threshold: 0.35 }
    );
    io.observe(el);
  }

  // Capabilities showcase — rail rows auto-advance and drive the morphing screen.
  const crail = document.querySelector<HTMLElement>('[data-crail]');
  const screen = document.querySelector<HTMLElement>('[data-capscreen]');
  if (crail && screen) {
    const DWELL = 3800;
    const rows = Array.from(crail.querySelectorAll<HTMLElement>('.crow'));
    const states = Array.from(screen.querySelectorAll<HTMLElement>('.capstate'));
    const reducedC = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let idx = 0, timer = 0, inView = false;

    const show = (i: number) => {
      idx = (i + rows.length) % rows.length;
      rows.forEach((r, n) => { const on = n === idx; r.classList.toggle('is-active', on); r.setAttribute('aria-selected', String(on)); });
      states.forEach((s, n) => s.classList.toggle('is-active', n === idx));
    };
    const stop = () => { if (timer) { clearInterval(timer); timer = 0; } };
    const play = () => { stop(); if (reducedC) return; timer = window.setInterval(() => show(idx + 1), DWELL); };
    const goto = (i: number) => { show(i); if (inView) play(); };

    rows.forEach((r, n) => {
      r.addEventListener('click', () => goto(n));
      r.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); goto(n); }
        if (e.key === 'ArrowDown' || e.key === 'ArrowRight') { e.preventDefault(); rows[(n + 1) % rows.length].focus(); goto(n + 1); }
        if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') { e.preventDefault(); rows[(n - 1 + rows.length) % rows.length].focus(); goto(n - 1); }
      });
    });

    new IntersectionObserver((entries) => entries.forEach((e) => {
      inView = e.isIntersecting;
      if (inView) play(); else stop();
    }), { threshold: 0.3 }).observe(screen);
  }
</script>
