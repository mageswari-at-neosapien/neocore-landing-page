---
// Closing CTA. (The step-by-step pilot fold was removed per review.)
---

<section id="pilot" class="fold pilot">
  <div class="shell">
    <div class="terminus reveal">
      <div class="terminus__glow" aria-hidden="true"></div>
      <div class="terminus__text">
        <h2 class="terminus__h">See NeoCore on your own conversations.</h2>
        <p class="terminus__sub">Book a demo and we will scope the team, workflows, languages, integrations and success measures with you.</p>
      </div>
      <button type="button" class="pill pill-lg terminus__cta" data-lead-open data-evt="pilot_cta_click" data-evt-source="pilot">
        Book a demo <span class="ico" aria-hidden="true">→</span>
      </button>
    </div>
  </div>
</section>

<style>
  /* dimmed closing CTA — dark accent-tinted card, not a bright fill */
  .terminus { position: relative; overflow: hidden; background: linear-gradient(135deg, color-mix(in srgb, var(--green) 16%, var(--bubble)), var(--bubble) 72%); border: 1px solid color-mix(in srgb, var(--green) 26%, transparent); border-radius: var(--r-l); padding: clamp(32px, 4.5vw, 60px); display: grid; grid-template-columns: 1fr auto; align-items: center; gap: clamp(24px, 3vw, 48px); box-shadow: var(--shadow-3); }
  .terminus__glow { position: absolute; right: -6%; top: -40%; width: 420px; height: 420px; border-radius: 50%; background: radial-gradient(circle, var(--green-glow), transparent 65%); pointer-events: none; }
  .terminus__text { position: relative; }
  .terminus__h { color: var(--bubble-ink); font-size: clamp(1.9rem, 3.2vw, 2.8rem); font-weight: 600; letter-spacing: -0.025em; }
  .terminus__sub { color: var(--bubble-ink-2); margin-top: 12px; font-size: 1.08rem; line-height: 1.5; max-width: 50ch; }
  .terminus__cta { position: relative; background: var(--btn-bg); color: var(--btn-text); flex: none; }
  .terminus__cta .ico { background: var(--btn-ico-bg); color: var(--btn-ico-ink); }

  @media (max-width: 760px) { .terminus { grid-template-columns: 1fr; } .terminus__cta { width: 100%; justify-content: space-between; } }
</style>
