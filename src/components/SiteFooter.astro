---
import BrandLogo from './BrandLogo.astro';
const year = 2026;
const links = [
  { href: '/#why-neocore', label: 'Why NeoCore' },
  { href: '/#security', label: 'Security and Privacy' },
  { href: '/#industries', label: 'Industries' },
  { href: '/#faq', label: 'FAQ' },
];
---

<footer class="foot">
  <div class="shell">
    <!-- closing CTA, merged into the footer -->
    <div class="foot__cta reveal">
      <div class="foot__cta-text">
        <h2 class="foot__ctah">See NeoCore on your own <span class="b">conversations.</span></h2>
        <p class="foot__ctasub">Book a demo and we will scope the team, workflows, languages, integrations and success measures with you.</p>
      </div>
      <button type="button" class="pill pill-lg foot__cta-btn" data-lead-open data-evt="footer_cta_click" data-evt-source="footer">
        Book a demo <span class="ico" aria-hidden="true">→</span>
      </button>
    </div>

    <div class="foot__top">
      <div class="foot__brand">
        <a href="/#top" class="brand" aria-label="NeoSapien NeoCore, home">
          <BrandLogo />
        </a>
        <p class="foot__tag">Frontline conversation intelligence: pitch adherence, coaching and Voice of Customer, across teams, regions and languages.</p>
      </div>
      <nav class="foot__col" aria-label="Footer sections">
        <span class="foot__ct">Sections</span>
        {links.map((l) => <a href={l.href} class="foot__link">{l.label}</a>)}
      </nav>
      <nav class="foot__col" aria-label="Legal">
        <span class="foot__ct">Legal</span>
        <a href="/privacy" class="foot__link">Privacy Policy</a>
        <a href="/terms" class="foot__link">Terms</a>
      </nav>
    </div>

    <div class="foot__bottom">
      <span>© {year} NeoSapien · NeoCore</span>
      <span class="muted">ISO 27001 certified.</span>
    </div>
  </div>
</footer>

<style>
  .foot { padding-block: clamp(32px, 4vw, 56px) clamp(40px, 5vw, 64px); }

  /* combined closing-CTA band */
  .foot__cta { position: relative; overflow: hidden; background: linear-gradient(135deg, color-mix(in srgb, var(--green) 16%, var(--bubble)), var(--bubble) 72%);
    border: 1px solid color-mix(in srgb, var(--green) 26%, transparent); border-radius: var(--r-l); padding: clamp(30px, 4vw, 56px);
    display: grid; grid-template-columns: 1fr auto; align-items: center; gap: clamp(24px, 3vw, 48px); box-shadow: var(--shadow-3); }
  .foot__ctah { color: var(--bubble-ink); font-size: clamp(1.9rem, 3.2vw, 2.8rem); font-weight: 600; letter-spacing: -0.025em; }
  .foot__ctah .b { color: var(--green); }
  .foot__ctasub { color: var(--bubble-ink-2); margin-top: 12px; font-size: 1.08rem; line-height: 1.5; max-width: 50ch; }
  .foot__cta-btn { flex: none; }

  .foot__top { margin-top: clamp(40px, 5vw, 64px); display: grid; grid-template-columns: 1.6fr 1fr 1fr; gap: clamp(24px, 4vw, 56px); }
  .brand { display: inline-flex; align-items: center; text-decoration: none; }
  .foot__tag { max-width: 42ch; margin-top: 18px; color: var(--ink-2); font-size: .98rem; line-height: 1.5; }
  .foot__col { display: grid; align-content: start; gap: 14px; }
  .foot__ct { font-size: .8rem; font-weight: 600; letter-spacing: .05em; text-transform: uppercase; color: var(--ink-3); }
  .foot__link { text-decoration: none; color: var(--ink-2); font-size: 1rem; }
  .foot__link:hover { color: var(--ink); }
  .foot__bottom { margin-top: 40px; padding-top: 24px; border-top: 1px solid var(--hair); display: flex; justify-content: space-between; gap: 14px; flex-wrap: wrap; font-size: .9rem; color: var(--ink-2); }

  @media (max-width: 760px) {
    .foot__cta { grid-template-columns: 1fr; }
    .foot__cta-btn { width: 100%; justify-content: space-between; }
    .foot__top { grid-template-columns: 1fr 1fr; }
    .foot__brand { grid-column: 1 / -1; }
  }
  @media (max-width: 460px) { .foot__top { grid-template-columns: 1fr; } }
</style>
