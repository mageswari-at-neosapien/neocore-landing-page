---
import BrandLogo from './BrandLogo.astro';
const year = new Date().getFullYear();
const links = [
  { href: '#how-it-works', label: 'How it works' },
  { href: '#outcomes', label: 'Outcomes' },
  { href: '#security', label: 'Security' },
  { href: '#faq', label: 'FAQ' },
];
---

<footer class="foot">
  <div class="shell">
    <div class="foot__top">
      <div class="foot__brand">
        <a href="#top" class="brand" aria-label="NeoSapien NeoCore, home">
          <BrandLogo />
        </a>
        <p class="foot__tag">Frontline conversation intelligence: pitch adherence, coaching and Voice of Customer, across teams, regions and languages.</p>
        <button type="button" class="pill" data-lead-open data-evt="footer_cta_click" data-evt-source="footer">Talk to our enterprise team <span class="ico" aria-hidden="true">→</span></button>
      </div>
      <nav class="foot__col" aria-label="Footer sections">
        <span class="foot__ct">Sections</span>
        {links.map((l) => <a href={l.href} class="foot__link">{l.label}</a>)}
      </nav>
      <nav class="foot__col" aria-label="Legal">
        <span class="foot__ct">Legal</span>
        <a href="#" class="foot__link" data-legal="privacy">Privacy Policy</a>
        <a href="#" class="foot__link" data-legal="terms">Terms</a>
      </nav>
    </div>
    <div class="foot__bottom">
      <span>© {year} NeoSapien · NeoCore</span>
      <span class="muted">ISO 27001 certified.</span>
    </div>
  </div>
</footer>

<style>
  .foot { border-top: 1px solid var(--hair); padding-block: clamp(48px, 6vw, 72px); }
  .foot__top { display: grid; grid-template-columns: 1.6fr 1fr 1fr; gap: clamp(24px, 4vw, 56px); }
  .brand { display: inline-flex; align-items: center; text-decoration: none; }
  .foot__tag { max-width: 42ch; margin: 18px 0 24px; color: var(--ink-2); font-size: .98rem; line-height: 1.5; }
  .foot__col { display: grid; align-content: start; gap: 14px; }
  .foot__ct { font-size: .8rem; font-weight: 600; letter-spacing: .05em; text-transform: uppercase; color: var(--ink-3); }
  .foot__link { text-decoration: none; color: var(--ink-2); font-size: 1rem; }
  .foot__link:hover { color: var(--ink); }
  .foot__bottom { margin-top: 48px; padding-top: 24px; border-top: 1px solid var(--hair); display: flex; justify-content: space-between; gap: 14px; flex-wrap: wrap; font-size: .9rem; color: var(--ink-2); }
  @media (max-width: 760px) { .foot__top { grid-template-columns: 1fr 1fr; } .foot__brand { grid-column: 1 / -1; } }
  @media (max-width: 460px) { .foot__top { grid-template-columns: 1fr; } }
</style>
