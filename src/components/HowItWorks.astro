---
// Fold 3 — flowing 5-step journey; the intelligence layer carries the weight.
const steps = [
  { n: 'Capture', c: 'Neo One captures frontline conversations with minimal effort.', input: true },
  { n: 'Understand', c: 'Speech in 100+ languages, speakers separated, company vocabulary understood.' },
  { n: 'Structure', c: 'Custom fields map each conversation to the messages and steps that matter.' },
  { n: 'Aggregate', c: 'Signals roll up across reps, teams, regions, products and time.' },
  { n: 'Act', c: 'Leaders see adherence gaps, coaching priorities and Voice of Customer.' },
];
---

<section id="how-it-works" class="fold how">
  <div class="shell">
    <div class="how__bridge reveal">
      <h2 class="display how__bridgeh">
        Your CRM shows what happened.<br /><span class="b">Frontline conversations reveal why.</span>
      </h2>
      <p class="lede how__support">
        Manual notes and occasional ride-alongs leave most field conversations invisible.
        NeoCore turns them into structured intelligence managers can act on.
      </p>
    </div>

    <div class="journey reveal">
      <div class="journey__labels">
        <span class="jl jl--input">Input</span>
        <span class="jl jl--core">NeoCore intelligence layer</span>
      </div>
      <div class="journey__line" aria-hidden="true"></div>
      <ol class="journey__steps">
        {steps.map((s, i) => (
          <li class="jstep" class:list={[{ 'jstep--input': s.input }]}>
            <span class="node jnode" aria-hidden="true"></span>
            <span class="jstep__i">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="jstep__n">{s.n}</h3>
            <p class="jstep__c">{s.c}</p>
          </li>
        ))}
      </ol>
    </div>

    <p class="tag how__foot">Turn conversations into management intelligence</p>
  </div>
</section>

<style>
  .how__bridge { max-width: 960px; }
  .how__bridgeh { font-size: clamp(2.2rem, 4.4vw, 3.6rem); }
  .how__bridgeh .b { color: var(--ink); }
  .how__support { margin-top: 24px; max-width: 60ch; }

  .journey { position: relative; margin-top: 64px; }
  .journey__labels { display: grid; grid-template-columns: 1fr 4fr; gap: 12px; margin-bottom: 26px; }
  .jl { font-size: .72rem; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; }
  .jl--input { color: var(--ink-3); }
  .jl--core { color: var(--green-text); display: inline-flex; align-items: center; gap: 9px; }
  .jl--core::before { content: ""; width: 8px; height: 8px; border-radius: 50%; background: var(--green); }
  .journey__line { position: absolute; top: calc(26px + .72rem + 26px + 7px); left: 7px; right: 7px; height: 2px; background: repeating-linear-gradient(90deg, var(--hair) 0 7px, transparent 7px 14px); }
  .journey__steps { position: relative; list-style: none; display: grid; grid-template-columns: repeat(5, 1fr); gap: 18px; }
  .jstep { padding-right: 14px; }
  .jnode { display: block; margin-bottom: 20px; }
  .jstep--input .jnode { background: var(--ink-3); box-shadow: 0 0 0 5px var(--ground), 0 0 0 6px var(--hair); }
  .jstep__i { font-size: .74rem; font-weight: 600; color: var(--green-text); }
  .jstep--input .jstep__i { color: var(--ink-3); }
  .jstep__n { font-size: 1.28rem; font-weight: 500; margin-top: 4px; }
  .jstep__c { margin-top: 10px; color: var(--ink-2); font-size: .92rem; line-height: 1.45; }

  .how__foot { margin-top: 40px; }

  @media (max-width: 900px) {
    .journey__labels { grid-template-columns: 1fr; gap: 6px; }
    .journey__line { display: none; }
    .journey__steps { grid-template-columns: 1fr 1fr; gap: 28px 18px; }
    .jnode { margin-bottom: 12px; }
  }
  @media (max-width: 520px) { .journey__steps { grid-template-columns: 1fr; } }
</style>
