---
import '@fontsource-variable/schibsted-grotesk';
import '@fontsource-variable/spline-sans-mono';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'NeoCore for Enterprise — Make frontline sales conversations visible, measurable and actionable',
  description = 'Measure pitch adherence, identify coaching priorities and hear the Voice of Customer — across teams, regions and languages. Talk to our enterprise team.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <!--
    THESIS: This page sells the intelligence layer, not the gadget: management
    visibility rendered as a working instrument panel. It refuses the AI-startup
    default — neon-glow hero, device beauty shot, equal icon-card features.
    OWN-WORLD: Layered evergreen grounds (#060f0a to #133023) under hairline
    #1e3d2c structure; bright #3fe07c reserved for action and live data; white
    Schibsted Grotesk headlines; Spline Sans Mono for measured values; motion is
    one restrained signal-flow reveal, nothing scattered.
    STORY: A sales-excellence leader sees frontline conversations become
    adherence, coaching and Voice-of-Customer intelligence, trusts it is
    enterprise-safe, and books a conversation with the enterprise team.
    FIRST VIEWPORT: Sticky nav; 45/55 split — eyebrow, headline, description,
    primary CTA and proof line left; an "Illustrative view" adherence dashboard
    right, fed by a small Neo One capture signal entering from the left edge.
    FORM: Brief-pinned direction — the NeoSapien enterprise visual system and a
    mandated seven-fold structure from the client brief; pinned brief beats the
    roll, so no concept seed was drawn. seed: brief-pinned.
    FINISH: unreviewed and undocumented is unfinished; this build ends with the
    finish review, the verdict, and DESIGN.md
    -->
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
    <script>
      // ---- Analytics: declarative event hooks (brief §5) ----
      // Elements opt in with data-evt="event_name" (clicks) or
      // data-evt-view="event_name" (first scroll into view).
      declare global {
        interface Window {
          dataLayer: Record<string, unknown>[];
          neoTrack: (event: string, detail?: Record<string, unknown>) => void;
        }
      }
      window.dataLayer = window.dataLayer || [];
      window.neoTrack = (event, detail = {}) => {
        window.dataLayer.push({ event, ...detail, ts: Date.now() });
      };

      document.addEventListener('click', (e) => {
        const el = (e.target as HTMLElement).closest<HTMLElement>('[data-evt]');
        if (el) window.neoTrack(el.dataset.evt!, { source: el.dataset.evtSource || undefined });
      });

      if ('IntersectionObserver' in window) {
        const seen = new WeakSet<Element>();
        const viewObserver = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting && !seen.has(entry.target)) {
                seen.add(entry.target);
                window.neoTrack((entry.target as HTMLElement).dataset.evtView!);
                viewObserver.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.4 }
        );
        document.querySelectorAll<HTMLElement>('[data-evt-view]').forEach((el) => viewObserver.observe(el));

        // ---- Reveal: the one entrance grammar (one entrance per fold) ----
        const revealObserver = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-in');
                revealObserver.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.12 }
        );
        document.querySelectorAll('.reveal').forEach((el) => revealObserver.observe(el));
      } else {
        document.querySelectorAll('.reveal').forEach((el) => el.classList.add('is-in'));
      }
    </script>
  </body>
</html>
