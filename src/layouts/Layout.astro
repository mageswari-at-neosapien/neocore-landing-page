---
import '@fontsource-variable/outfit';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'NeoCore for Enterprise · Make frontline sales conversations visible, measurable and actionable',
  description = 'Measure pitch adherence, identify coaching priorities and hear the Voice of Customer, across teams, regions and languages. Talk to our enterprise team.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#ebebeb" />
    <script is:inline>
      // No-flash theme: localStorage → system preference → light
      (function () {
        try {
          var t = localStorage.getItem('neo-theme');
          if (!t) t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          document.documentElement.setAttribute('data-theme', t);
        } catch (e) { document.documentElement.setAttribute('data-theme', 'light'); }
        document.documentElement.classList.add('js');
      })();
    </script>
  </head>
  <body>
    <!--
    THESIS: The NeoCore enterprise page lives inside NeoSapien's own brand world
    (neosapien.ai): soft light ground, mint-gradient cards, dark rounded product
    "screens", brand green as the one accent. It sells the intelligence, not a
    device, and refuses data-table dashboards — every reading is a friendly card.
    OWN-WORLD: Light ground #ebebeb (or dark #0a0f0c), Outfit type (light display
    weights with bold emphasis words), floating white pill nav, dark pill buttons
    with green text (green fill in dark theme), mint→white gradient cards holding
    dark rounded insets with green-checked rows. One brand green #00df79 throughout.
    STORY: A sales-excellence leader sees one field conversation become adherence,
    coaching and Voice-of-Customer intelligence, trusts it is enterprise-safe, and
    books a conversation with the enterprise team.
    FIRST VIEWPORT: Floating pill nav (with light/dark toggle); left — eyebrow chip,
    light-weight headline with bold emphasis, lede, dark pill CTA, proof chips;
    right — a mint gradient card with a dark inset showing conversation→intelligence.
    FORM: NeoSapien brand-matched, user-directed (rejected the dark-transit world);
    two themes, brand green the constant. seed: brand-matched (neosapien.ai).
    FINISH: unreviewed and undocumented is unfinished; this build ends with the
    finish review, the verdict, and DESIGN.md
    -->
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
    <script>
      declare global {
        interface Window {
          dataLayer: Record<string, unknown>[];
          neoTrack: (event: string, detail?: Record<string, unknown>) => void;
        }
      }
      // ---- Theme menu (Daylight / Midnight / Slate / Sand) ----
      const root = document.documentElement;
      const themeMenu = document.querySelector<HTMLElement>('[data-theme-menu]');
      if (themeMenu) {
        const btn = themeMenu.querySelector<HTMLButtonElement>('[data-theme-btn]')!;
        const pop = themeMenu.querySelector<HTMLElement>('[data-theme-pop]')!;
        const opts = Array.from(themeMenu.querySelectorAll<HTMLButtonElement>('[data-set-theme]'));

        const mark = () => {
          const cur = root.getAttribute('data-theme') || 'light';
          opts.forEach((o) => o.setAttribute('aria-checked', String(o.dataset.setTheme === cur)));
        };
        const setTheme = (t: string) => {
          root.setAttribute('data-theme', t);
          try { localStorage.setItem('neo-theme', t); } catch {}
          mark();
        };
        const open = (o: boolean) => { pop.hidden = !o; btn.setAttribute('aria-expanded', String(o)); };

        mark();
        btn.addEventListener('click', (e) => { e.stopPropagation(); open(pop.hidden); });
        opts.forEach((o) => o.addEventListener('click', () => { setTheme(o.dataset.setTheme!); open(false); }));
        document.addEventListener('click', (e) => {
          if (!pop.hidden && !themeMenu.contains(e.target as Node)) open(false);
        });
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape') open(false); });
      }

      // ---- Analytics (brief §5): data-evt (click) / data-evt-view (first view) ----
      window.dataLayer = window.dataLayer || [];
      window.neoTrack = (event, detail = {}) => window.dataLayer.push({ event, ...detail, ts: Date.now() });
      document.addEventListener('click', (e) => {
        const el = (e.target as HTMLElement).closest<HTMLElement>('[data-evt]');
        if (el) window.neoTrack(el.dataset.evt!, { source: el.dataset.evtSource || undefined });
      });

      if ('IntersectionObserver' in window) {
        const seen = new WeakSet<Element>();
        const viewObs = new IntersectionObserver((entries) => {
          for (const en of entries) if (en.isIntersecting && !seen.has(en.target)) {
            seen.add(en.target); window.neoTrack((en.target as HTMLElement).dataset.evtView!); viewObs.unobserve(en.target);
          }
        }, { threshold: 0.4 });
        document.querySelectorAll<HTMLElement>('[data-evt-view]').forEach((el) => viewObs.observe(el));

        const revObs = new IntersectionObserver((entries) => {
          for (const en of entries) if (en.isIntersecting) { en.target.classList.add('is-in'); revObs.unobserve(en.target); }
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.12 });
        document.querySelectorAll('.reveal, .mark').forEach((el) => revObs.observe(el));
      } else {
        document.querySelectorAll('.reveal, .mark').forEach((el) => el.classList.add('is-in'));
      }

      // ---- Mobile nav drawer ----
      const navT = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
      const navD = document.querySelector<HTMLElement>('[data-nav-drawer]');
      if (navT && navD) {
        const set = (o: boolean) => { navT.setAttribute('aria-expanded', String(o)); navD.hidden = !o; };
        navT.addEventListener('click', () => set(navT.getAttribute('aria-expanded') !== 'true'));
        navD.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) set(false); });
      }
    </script>
  </body>
</html>
