---
import Layout from '../layouts/Layout.astro';
import SiteNav from '../components/SiteNav.astro';
import Hero from '../components/Hero.astro';
import TrustProof from '../components/TrustProof.astro';
import WhyNeoCore from '../components/WhyNeoCore.astro';
import Security from '../components/Security.astro';
import Outcomes from '../components/Outcomes.astro';
import Produces from '../components/Produces.astro';
import Industries from '../components/Industries.astro';
import Faq from '../components/Faq.astro';
import SiteFooter from '../components/SiteFooter.astro';
import LeadForm from '../components/LeadForm.astro';
---

<Layout>
  <SiteNav />
  <main id="main">
    <Hero />
    <TrustProof />
    <WhyNeoCore />
    <Security />
    <Outcomes />
    <Produces />
    <Industries />
    <Faq />
